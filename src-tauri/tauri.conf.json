{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "闪语", "version": "0.1.2", "identifier": "com.quickphrase.desktop",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "闪语", "width": 330, "height": 720, "minWidth": 300, "minHeight": 400, "decorations": false, "resizable": true, "visible": false, "focus": false, "skipTaskbar": true, "generalAutofillEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost 'self'",
      "assetProtocol": { "enable": true, "scope": ["$APPLOCALDATA/images/**", "$APPLOCALDATA/thumbnails/**"] }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
