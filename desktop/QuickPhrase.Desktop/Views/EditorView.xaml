<UserControl x:Class="QuickPhrase.Desktop.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:QuickPhrase.Desktop.ViewModels"
             mc:Ignorable="d">
    <!-- 编辑器只编排表单和命令；颜色、排版、间距及控件状态均由全局 Design System 提供。 -->
    <Grid Background="{DynamicResource Brush.Background.Default}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Thickness.Page}">
            <!-- 480px 是编辑表单的单次内容宽度约束，不属于通用控件视觉尺寸。 -->
            <StackPanel MaxWidth="{StaticResource Size.Editor.Content.Maximum}" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding HeaderTitle}"
                           Style="{StaticResource Style.Text.Title.Medium}"
                           Margin="{StaticResource Thickness.Section}" />

                <TextBlock Text="标题"
                           Style="{StaticResource Style.Text.Label}"
                           Margin="{StaticResource Thickness.Gap.Stack.XS}" />
                <TextBox x:Name="TitleBox"
                         Style="{StaticResource Style.Input.Default}"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{StaticResource Thickness.Gap.Stack.LG}" />

                <TextBlock Text="正文"
                           Style="{StaticResource Style.Text.Label}"
                           Margin="{StaticResource Thickness.Gap.Stack.XS}" />
                <TextBox Style="{StaticResource Style.Input.Default}"
                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         Height="{StaticResource Size.Editor.Body.Height}"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Padding="{StaticResource Thickness.Control.Input.Multiline}"
                         Margin="{StaticResource Thickness.Gap.Stack.LG}" />

                <TextBlock Text="分类"
                           Style="{StaticResource Style.Text.Label}"
                           Margin="{StaticResource Thickness.Gap.Stack.XS}" />
                <ComboBox x:Name="CategoryCombo"
                          Style="{StaticResource Style.Select.Default}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCategoryId}"
                          Margin="{StaticResource Thickness.Gap.Stack.LG}">
                    <!-- 分组只表达一级/二级分类层级，不改变现有分类绑定与选择语义。 -->
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource Style.Text.Label}"
                                               Margin="{StaticResource Thickness.XS}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                </ComboBox>

                <TextBlock Text="颜色标记"
                           Style="{StaticResource Style.Text.Label}"
                           Margin="{StaticResource Thickness.Gap.Stack.XS}" />
                <!-- 固定色板仍由 ListBoxItem 承担键盘焦点和单选；仅将视觉尺寸、圆角和状态色切换到 Token。 -->
                <ListBox x:Name="ColorPalette"
                         ItemsSource="{x:Static vm:EditorViewModel.ColorKeys}"
                         SelectedValuePath="Key"
                         SelectedValue="{Binding ColorKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="{StaticResource Thickness.None}"
                         HorizontalContentAlignment="Left"
                         KeyboardNavigation.DirectionalNavigation="Cycle"
                         Margin="{StaticResource Thickness.Gap.Stack.LG}"
                         AutomationProperties.Name="颜色标记色板">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
                            <Setter Property="Margin" Value="{StaticResource Thickness.Gap.Inline.SM}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ColorTile"
                                                Width="{StaticResource Size.Control.Compact}"
                                                Height="{StaticResource Size.Control.Compact}"
                                                CornerRadius="{StaticResource Radius.XL}"
                                                Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                                BorderThickness="{StaticResource Thickness.Border.Default}"
                                                ToolTip="{Binding Label}">
                                            <Grid>
                                                <TextBlock x:Name="CheckMark"
                                                           Text="✓"
                                                           Style="{StaticResource Style.Text.Title.Medium}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ColorTile" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ColorTile" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                                                <Setter TargetName="ColorTile" Property="BorderThickness" Value="3" />
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="ColorTile" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ColorTile" Property="BorderBrush" Value="{DynamicResource Brush.Text.Disabled}" />
                                                <Setter TargetName="CheckMark" Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 操作栏沿用原命令和可见性绑定，只统一为 Danger / Secondary / Primary 语义按钮。 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.Default}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="{StaticResource Thickness.Border.Top}"
                Padding="{StaticResource Thickness.Page}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Style.Text.Body.Small}"
                           Foreground="{DynamicResource Brush.Status.Error}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Style.Button.Danger}"
                            Content="删除"
                            Command="{Binding DeleteCommand}"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                            Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                    <Button Style="{StaticResource Style.Button.Secondary}"
                            Content="取消"
                            Command="{Binding CancelCommand}"
                            Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                    <Button Style="{StaticResource Style.Button.Primary}"
                            Content="保存"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
