<Window x:Class="QuickPhrase.Desktop.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:designSystem="clr-namespace:QuickPhrase.Desktop.DesignSystem.Components"
        Width="{StaticResource Size.Dialog.Shortcut.Width}"
        Height="{StaticResource Size.Dialog.Shortcut.Height}"
        Style="{StaticResource Style.Dialog.Window}"
        Title="设置快捷键"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置快捷键"
                   Style="{StaticResource Style.Text.Title.Medium}"
                   Margin="{StaticResource Thickness.Gap.Stack.XS}" />
        <TextBlock Grid.Row="1"
                   Text="点击下方控件，然后按下新的快捷键组合。"
                   Style="{StaticResource Style.Text.Body.Small}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Margin="{StaticResource Thickness.Gap.Stack.LG}" />

        <designSystem:ShortcutInput x:Name="CapturedShortcut"
                                    Grid.Row="2"
                                    Chord="{Binding CandidateChord, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ErrorMessage="{Binding CaptureErrorMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CaptureCompleted="CapturedShortcut_CaptureCompleted"
                                    CaptureCanceled="CapturedShortcut_CaptureCanceled"
                                    VerticalAlignment="Top" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Style="{StaticResource Style.Button.Ghost}"
                    Content="取消"
                    Margin="{StaticResource Thickness.Gap.Inline.SM}"
                    Click="Cancel_Click" />
            <Button x:Name="SaveButton"
                    Style="{StaticResource Style.Button.Primary}"
                    Content="保存"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
