<Window x:Class="QuickPhrase.Desktop.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="200"
        Style="{StaticResource DialogWindow}" Title="设置快捷键"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="请按下新的快捷键组合" Style="{StaticResource TextBody}" />
        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                CornerRadius="6" Margin="0,12">
            <TextBlock x:Name="CapturedText" Text="按下组合键…"
                       Style="{StaticResource TextH2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="确定" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
