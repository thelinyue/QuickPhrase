<Window x:Class="QuickPhrase.Desktop.ImportPhrasePackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="560" MinWidth="460" MinHeight="420"
        Style="{StaticResource DialogWindow}" Title="导入话术包"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Package.Manifest.Name}" Style="{StaticResource TextH2}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,12">
            <TextBlock Text="新增分类" Style="{StaticResource TextCaption}" />
            <TextBlock Text="{Binding NewCategoryCount}" Style="{StaticResource TextBody}" Margin="4,0,16,0" />
            <TextBlock Text="新增话术" Style="{StaticResource TextCaption}" />
            <TextBlock Text="{Binding NewPhraseCount}" Style="{StaticResource TextBody}" Margin="4,0,16,0" />
            <TextBlock Text="跳过重复" Style="{StaticResource TextCaption}" />
            <TextBlock Text="{Binding SkippedDuplicateCount}" Style="{StaticResource TextBody}" Margin="4,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource GhostButton}" Content="全选" Click="SelectAll_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="全不选" Click="SelectNone_Click" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Category.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,5,0,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="取消"
                        Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="确认导入"
                        Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
