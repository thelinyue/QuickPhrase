<Window x:Class="QuickPhrase.Desktop.ImportPhrasePackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="{StaticResource Size.Dialog.Import.Width}" Height="{StaticResource Size.Dialog.Import.Height}" MinWidth="{StaticResource Size.Dialog.Import.MinimumWidth}" MinHeight="{StaticResource Size.Dialog.Import.MinimumHeight}"
        Style="{StaticResource Style.Dialog.Window}" Title="导入话术包"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="{StaticResource Thickness.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Package.Manifest.Name}" Style="{StaticResource Style.Text.Title.Medium}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource Thickness.Dialog.Summary}">
            <TextBlock Text="新增分类" Style="{StaticResource Style.Text.Caption}" />
            <TextBlock Text="{Binding NewCategoryCount}" Style="{StaticResource Style.Text.Body.Medium}" Margin="{StaticResource Thickness.Dialog.SummaryValue}" />
            <TextBlock Text="新增话术" Style="{StaticResource Style.Text.Caption}" />
            <TextBlock Text="{Binding NewPhraseCount}" Style="{StaticResource Style.Text.Body.Medium}" Margin="{StaticResource Thickness.Dialog.SummaryValue}" />
            <TextBlock Text="跳过重复" Style="{StaticResource Style.Text.Caption}" />
            <TextBlock Text="{Binding SkippedDuplicateCount}" Style="{StaticResource Style.Text.Body.Medium}" Margin="{StaticResource Thickness.Dialog.SummaryValue.Last}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Style.Card.Default}" Padding="{StaticResource Thickness.MD}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource Thickness.Gap.Stack.SM}">
                    <Button Style="{StaticResource Style.Button.Ghost.Compact}" Content="全选" Click="SelectAll_Click" Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                    <Button Style="{StaticResource Style.Button.Ghost.Compact}" Content="全不选" Click="SelectNone_Click" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Category.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="{StaticResource Thickness.Dialog.Option}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="{StaticResource Thickness.Dialog.Footer}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Error}"
                       Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Gap.Stack.SM}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource Style.Button.Ghost}" Content="取消"
                        Click="Cancel_Click" IsCancel="True" Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Style.Button.Primary}" Content="确认导入"
                        Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
