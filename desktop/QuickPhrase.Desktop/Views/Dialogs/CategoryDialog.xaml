<Window x:Class="QuickPhrase.Desktop.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="{StaticResource Size.Dialog.Category.Width}" MinHeight="{StaticResource Size.Dialog.Category.MinimumHeight}" Height="{StaticResource Size.Dialog.Category.Height}"
        SizeToContent="Height"
        Style="{StaticResource Style.Dialog.Window}" Title="分类"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="{StaticResource Thickness.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="分类名称" Style="{StaticResource Style.Text.Label}" Margin="{StaticResource Thickness.Gap.Stack.SM}" />
        <TextBox x:Name="NameBox" Grid.Row="1" Style="{StaticResource Style.Input.Default}" />
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource Brush.Status.Error}"
                   Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap"
                   MinHeight="{StaticResource Size.Dialog.Status.MinimumHeight}" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" />
        <!-- 底部操作栏复用语义边框与按钮 Style，仅保留上下分区所需的非对称结构间距。 -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="{StaticResource Thickness.Border.Top}"
                Margin="{StaticResource Thickness.Dialog.Footer}" Padding="{StaticResource Thickness.Dialog.Footer.Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource Style.Button.Ghost}" Content="取消"
                        Click="Cancel_Click" Margin="{StaticResource Thickness.Gap.Inline.SM}" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource Style.Button.Primary}" Content="确定"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
