<Window x:Class="QuickPhrase.Desktop.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" MinHeight="200" Height="240"
        SizeToContent="Height"
        Style="{StaticResource DialogWindow}" Title="分类"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="分类名称" Style="{StaticResource TextEyebrow}" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Grid.Row="1" Style="{StaticResource BaseTextBox}" />
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerBrush}"
                   Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                   MinHeight="20" Margin="0,8,0,0" />
        <!-- 底部操作栏：分隔线之上、底部 16px 内边距、按钮右对齐；与话术库底部栏样式一致 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Margin="0,16,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="取消"
                        Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="确定"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
