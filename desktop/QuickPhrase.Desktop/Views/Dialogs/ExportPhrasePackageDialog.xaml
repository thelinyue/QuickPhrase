<Window x:Class="QuickPhrase.Desktop.ExportPhrasePackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:QuickPhrase.Core;assembly=QuickPhrase.Core"
        Width="{StaticResource Size.Dialog.Export.Width}" Height="{StaticResource Size.Dialog.Export.Height}" MinWidth="{StaticResource Size.Dialog.Export.MinimumWidth}" MinHeight="{StaticResource Size.Dialog.Export.MinimumHeight}"
        Style="{StaticResource Style.Dialog.Window}" Title="导出话术包"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="{StaticResource Thickness.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="导出范围" Style="{StaticResource Style.Text.Label}" Margin="{StaticResource Thickness.Gap.Stack.SM}" />
        <ComboBox x:Name="ScopeCombo" Grid.Row="1" SelectedIndex="0" SelectionChanged="ScopeCombo_SelectionChanged"
                  Margin="{StaticResource Thickness.Gap.Stack.MD}">
            <ComboBoxItem Tag="All" Content="全部话术" />
            <ComboBoxItem Tag="Categories" Content="按分类" />
            <ComboBoxItem Tag="Phrases" Content="按话术" />
        </ComboBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="CategoryPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Scope}" Value="{x:Static core:PhrasePackageExportScope.Categories}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.Gap.Stack.SM}">
                        <TextBlock Text="选择分类" Style="{StaticResource Style.Text.Title.Medium}" />
                        <Button Style="{StaticResource Style.Button.Ghost.Compact}" Content="全选" Click="SelectAll_Click" Margin="{StaticResource Thickness.Dialog.InlineAction}" />
                        <Button Style="{StaticResource Style.Button.Ghost.Compact}" Content="全不选" Click="SelectNone_Click" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Category.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="{StaticResource Thickness.Dialog.Option}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="PhrasePanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Scope}" Value="{x:Static core:PhrasePackageExportScope.Phrases}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.Gap.Stack.SM}">
                        <TextBlock Text="选择话术" Style="{StaticResource Style.Text.Title.Medium}" />
                        <Button Style="{StaticResource Style.Button.Ghost.Compact}" Content="全选" Click="SelectAll_Click" Margin="{StaticResource Thickness.Dialog.InlineAction}" />
                        <Button Style="{StaticResource Style.Button.Ghost.Compact}" Content="全不选" Click="SelectNone_Click" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Phrases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="{StaticResource Thickness.Dialog.Option}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Phrase.Title}" Style="{StaticResource Style.Text.Body.Medium}" />
                                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Style.Text.Caption}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="全部话术将自动包含其所属分类及祖先分类。导出文件不包含标签、颜色和本机设置。"
                           Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Dialog.Footer}" />
                <TextBlock Text="包名称" Style="{StaticResource Style.Text.Label}" Margin="{StaticResource Thickness.Dialog.SectionLabel}" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.Input.Default}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="{StaticResource Thickness.Dialog.Footer}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Error}"
                       Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Gap.Stack.SM}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Style.Button.Ghost}" Content="取消" Click="Cancel_Click" IsCancel="True" Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                <Button Style="{StaticResource Style.Button.Primary}" Content="继续" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
