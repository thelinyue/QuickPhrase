<Window x:Class="QuickPhrase.Desktop.ExportPhrasePackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:QuickPhrase.Core;assembly=QuickPhrase.Core"
        Width="560" Height="620" MinWidth="500" MinHeight="460"
        Style="{StaticResource DialogWindow}" Title="导出话术包"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="导出范围" Style="{StaticResource TextEyebrow}" Margin="0,0,0,8" />
        <ComboBox x:Name="ScopeCombo" Grid.Row="1" SelectedIndex="0" SelectionChanged="ScopeCombo_SelectionChanged"
                  Margin="0,0,0,12">
            <ComboBoxItem Tag="All" Content="全部话术" />
            <ComboBoxItem Tag="Categories" Content="按分类" />
            <ComboBoxItem Tag="Phrases" Content="按话术" />
        </ComboBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="CategoryPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Scope}" Value="{x:Static core:PhrasePackageExportScope.Categories}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="选择分类" Style="{StaticResource TextH2}" />
                        <Button Style="{StaticResource GhostButton}" Content="全选" Click="SelectAll_Click" Margin="16,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="全不选" Click="SelectNone_Click" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Category.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,5,0,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="PhrasePanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Scope}" Value="{x:Static core:PhrasePackageExportScope.Phrases}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="选择话术" Style="{StaticResource TextH2}" />
                        <Button Style="{StaticResource GhostButton}" Content="全选" Click="SelectAll_Click" Margin="16,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="全不选" Click="SelectNone_Click" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Phrases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,5,0,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Phrase.Title}" Style="{StaticResource TextBody}" />
                                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource TextCaption}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="全部话术将自动包含其所属分类及祖先分类。导出文件不包含标签、颜色和本机设置。"
                           Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,16,0,0" />
                <TextBlock Text="包名称" Style="{StaticResource TextEyebrow}" Margin="0,16,0,8" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="继续" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
