<Window x:Class="QuickPhrase.Desktop.PhraseMoveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="200"
        Style="{StaticResource DialogWindow}" Title="移动到分类"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="选择目标分类" Style="{StaticResource TextEyebrow}" Margin="0,0,0,6" />
        <ComboBox x:Name="CategoryCombo" Grid.Row="1" Height="36"
                  ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" />
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerBrush}"
                   Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="移动" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
