<Window x:Class="QuickPhrase.Desktop.NavigationConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="{StaticResource Size.Dialog.Navigation.Width}" Height="{StaticResource Size.Dialog.Navigation.Height}"
        Style="{StaticResource Style.Dialog.Window}" Title="未保存的改动"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="当前有未保存的改动，是否保存后再离开？"
                   Style="{StaticResource Style.Text.Body.Medium}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Thickness.Gap.Stack.Before.MD}">
            <Button Style="{StaticResource Style.Button.Ghost}" Content="继续编辑" Click="Continue_Click" Margin="{StaticResource Thickness.Gap.Inline.SM}" />
            <Button Style="{StaticResource Style.Button.Secondary}" Content="放弃改动" Click="Discard_Click" Margin="{StaticResource Thickness.Gap.Inline.SM}" />
            <Button Style="{StaticResource Style.Button.Primary}" Content="保存并离开" Click="SaveLeave_Click" />
        </StackPanel>
    </Grid>
</Window>
