<Window x:Class="QuickPhrase.Desktop.NavigationConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="190"
        Style="{StaticResource DialogWindow}" Title="未保存的改动"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="当前有未保存的改动，是否保存后再离开？"
                   Style="{StaticResource TextBody}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="继续编辑" Click="Continue_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="放弃改动" Click="Discard_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="保存并离开" Click="SaveLeave_Click" />
        </StackPanel>
    </Grid>
</Window>
