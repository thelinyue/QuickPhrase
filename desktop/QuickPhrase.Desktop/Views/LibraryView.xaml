<!-- 话术库：正式 WPF 单栏纵向布局。
     自上而下：Content Header → Category Chips（一级横向）→ 主列表（内联嵌套树）
             → Search Footer → App Footer（品牌 + 设置）。
     无左侧分类边栏、无右侧详情面板。 -->
<UserControl x:Class="QuickPhrase.Desktop.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:QuickPhrase.Desktop"
             xmlns:desktopControls="clr-namespace:QuickPhrase.Desktop.Controls"
             xmlns:vm="clr-namespace:QuickPhrase.Desktop.ViewModels"
             xmlns:shared="clr-namespace:QuickPhrase.Desktop.Views.Shared"
             Style="{StaticResource Style.View.Root}">

    <UserControl.Resources>
        <!-- 紧凑列表参数仅服务于话术库页面，使用语义资源集中表达，避免视觉字面量散落在模板中。 -->
        <sys:Double x:Key="Size.Library.SubHeader.Height">24</sys:Double>
        <sys:Double x:Key="Size.Library.SubHeader.ArrowWidth">16</sys:Double>
        <GridLength x:Key="Size.Library.SubHeader.ArrowColumn">16</GridLength>
        <GridLength x:Key="Size.Library.CompactList.GapColumn">0</GridLength>
        <!-- 话术行可见内容与第一个一级分类 chip 共用 16px 左侧基准线。 -->
        <Thickness x:Key="Thickness.Library.PhraseRow.Horizontal">16,0</Thickness>

        <!-- 业务专属分类控件只保留 Toggle/展开语义；全部视觉状态消费全局 Token。 -->
        <Style x:Key="Style.Library.CategoryChip" TargetType="ToggleButton">
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Padding" Value="{StaticResource Thickness.Control.Button.Compact}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.None}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
            <Setter Property="FontSize" Value="{StaticResource Typography.Label.FontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource Typography.Label.FontWeight}" />
            <!-- 一级分类始终以白字叠加在分类色底上，避免颜色标签退化为普通文本按钮。 -->
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}">
                                 <Grid>
                                <!-- 未选中时完整铺满浅色分类底色；颜色由分类名称稳定派生。 -->
                                <Border x:Name="DefaultCategoryBackground"
                                        Background="{Binding Name, Converter={StaticResource CategoryBackgroundBrush}}"
                                        CornerRadius="{StaticResource Radius.Control}" />
                                <!-- 选中时只切换同色系深色层，不改变标签尺寸或内容布局。 -->
                                <Border x:Name="SelectedCategoryBackground"
                                        Background="{Binding Name, Converter={StaticResource CategoryBackgroundBrush}, ConverterParameter=deep}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedCategoryBackground" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DefaultCategoryBackground" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SelectedCategoryBackground" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.Library.SubHeaderButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="{StaticResource Size.Library.SubHeader.Height}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
            <Setter Property="Margin" Value="{StaticResource Thickness.None}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{StaticResource Thickness.Border.Bottom}"
                                BorderBrush="{DynamicResource Brush.Border.Default}">
                            <ContentPresenter Margin="{StaticResource Thickness.None}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.Library.SubHeaderChevron" TargetType="Path">
            <Setter Property="Data" Value="M6 9l6 6 6-6" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="{StaticResource Size.Library.SubHeader.ArrowWidth}" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <!-- ContextMenu 只保留内容管理动作；投递入口唯一存在于闪念。 -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource Style.Menu.Item}" />
        <Style TargetType="Separator" BasedOn="{StaticResource Style.Menu.Separator}" />


        <!--
            话术库主列表与搜索结果共用这一份管理菜单。
            ContextMenu 脱离宿主视觉树，因此所有命令都从 PlacementTarget 读取实际话术行，
            保证两种结果入口的启用条件、删除参数和命令来源完全一致。
        -->
        <ContextMenu x:Key="PhraseRowContextMenu" x:Shared="False">
            <MenuItem Header="复制内容到剪贴板"
                      Command="{Binding PlacementTarget.DataContext.Owner.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="新增话术"
                      Command="{Binding PlacementTarget.DataContext.Owner.NewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="编辑"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanManage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Command="{Binding PlacementTarget.DataContext.Owner.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="排序" IsEnabled="False" />
            <MenuItem Header="移动到其它分类"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanManage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Command="{Binding PlacementTarget.DataContext.Owner.MoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="复制到其它分类" IsEnabled="False" />
            <Separator />
            <MenuItem Header="删除"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanManage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Command="{Binding PlacementTarget.DataContext.Owner.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="如何批量操作？" IsEnabled="False" />
        </ContextMenu>

        <!-- 话术行复用共享显示结构，但不注入任何 Insert/Send 命令。 -->
        <!-- 宿主只注入话术库完整管理菜单；标题·正文显示结构来自共享资源。 -->
        <DataTemplate x:Key="PhraseRowTemplate" DataType="{x:Type vm:PhraseItemViewModel}">
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource Template.Phrase.CompactRow}"
                            ContextMenu="{StaticResource PhraseRowContextMenu}" />
        </DataTemplate>

        <!-- 搜索结果独立于主列表，保留序号并提供弱化的所属分类信息。 -->
        <DataTemplate x:Key="SearchResultRowTemplate" DataType="{x:Type vm:PhraseItemViewModel}">
            <ContentControl ContextMenu="{StaticResource PhraseRowContextMenu}">
                <Grid Height="{StaticResource Size.Phrase.Row.Compact}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.Launcher.IndexColumn.GridLength}" />
                        <ColumnDefinition Width="{StaticResource Size.Launcher.TitleColumn.GridLength}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource Size.Launcher.CategoryColumn.GridLength}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource Style.Text.Mono}"
                               VerticalAlignment="Center"
                               Text="{Binding SearchResultIndex}" />
                    <Grid Grid.Column="1" Margin="{StaticResource Thickness.XS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource Brush.Accent.Soft}"
                                CornerRadius="{StaticResource Radius.XS}"
                                Padding="{StaticResource Thickness.Gap.Inline.XS}"
                                Margin="{StaticResource Thickness.Gap.Inline.XS}"
                                Visibility="{Binding IsEnterprise, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="企业"
                                       Style="{StaticResource Style.Text.Caption}"
                                       Foreground="{DynamicResource Brush.Accent.Primary.Pressed}" />
                        </Border>
                        <desktopControls:OverflowTextBlock Grid.Column="1"
                                                           Style="{StaticResource Style.Text.Label}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                                                           Text="{Binding Title}" />
                    </Grid>
                    <desktopControls:OverflowTextBlock Grid.Column="2"
                                                       Margin="{StaticResource Thickness.XS}"
                                                       Style="{StaticResource Style.Text.Body.Medium}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Content}" />
                    <desktopControls:OverflowTextBlock Grid.Column="3"
                                                       Margin="{StaticResource Thickness.XS}"
                                                       Style="{StaticResource Style.Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding CategoryName}" />
                </Grid>
            </ContentControl>
        </DataTemplate>

        <!-- 二级分类标题条模板。
             注：上下文菜单必须内联（不能引用 UserControl.Resources 里的 SubHeaderContextMenu），
             因为本模板由 DataTemplateSelector 加载，脱离视觉树，加载时无法向上查找 UserControl
             作用域的资源，会抛“找不到资源”的 XamlParseException（已在 2026-08-18 复现）。 -->
        <DataTemplate x:Key="SubHeaderTemplate" DataType="{x:Type vm:SubHeaderItem}">
            <ToggleButton Style="{StaticResource Style.Library.SubHeaderButton}"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          IsChecked="{Binding IsExpanded, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleSubCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Id}">
                <ToggleButton.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建话术"
                                  Command="{Binding PlacementTarget.Tag.NewPhraseInCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Category, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="重命名分类"
                                  Command="{Binding PlacementTarget.Tag.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Category, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="删除分类" Style="{StaticResource Style.Menu.Item.Danger}"
                                  Command="{Binding PlacementTarget.Tag.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Category, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ToggleButton.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.Library.SubHeader.ArrowColumn}" />
                        <ColumnDefinition Width="{StaticResource Size.Library.CompactList.GapColumn}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 左侧仅显示展开/收起箭头：展开朝下（0°），收起朝右（-90°），随 IsExpanded 旋转。
                         注：必须绑定 RotateTransform.Angle（double→double），
                         直接把转换结果绑定到 RenderTransform(Transform) 会因类型不匹配而旋转失效。 -->
                    <Path Grid.Column="0" Style="{StaticResource Style.Library.SubHeaderChevron}">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource BoolToArrowRotation}}" />
                        </Path.RenderTransform>
                    </Path>
                    <!-- 二级分类使用加粗主文本色，与一级分类的白字彩色标签形成明确层级。 -->
                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Style.Text.Label}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Grid>
            </ToggleButton>
        </DataTemplate>

        <!-- 混合列表模板选择器（必须定义在两个模板之后，避免同文件前向引用） -->
        <local:PhraseRowSelector x:Key="PhraseRowSelector"
                                 PhraseRowTemplate="{StaticResource PhraseRowTemplate}"
                                 SubHeaderTemplate="{StaticResource SubHeaderTemplate}" />

        <!-- 顶部一级分类 chip 模板 -->
        <DataTemplate x:Key="CategoryChipTemplate" DataType="{x:Type vm:CategoryItem}">
            <ToggleButton Style="{StaticResource Style.Library.CategoryChip}"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          ContextMenu="{StaticResource CategoryChipContextMenu}"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Id}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <!-- 一级分类 chip 右键菜单（对齐 design-system.md 3.1；“常用”亦为真实分类，共用此菜单） -->
        <ContextMenu x:Key="CategoryChipContextMenu" x:Shared="False">
            <MenuItem Header="新建二级分类"
                      Command="{Binding PlacementTarget.Tag.NewSubCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="在该分类下新建话术"
                      Command="{Binding PlacementTarget.Tag.NewPhraseInCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="重命名分类"
                      Command="{Binding PlacementTarget.Tag.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="删除分类" Style="{StaticResource Style.Menu.Item.Danger}"
                      Command="{Binding PlacementTarget.Tag.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- 话术库空白区域菜单。仅由 LibraryView 代码在确认未命中节点后打开，
             不绑定到话术行或分类节点，避免与已有节点级菜单冲突。 -->
        <ContextMenu x:Key="BlankAreaContextMenu"
                     Placement="MousePoint"
                     StaysOpen="False"
                     Closed="BlankAreaContextMenu_Closed"
                     PreviewKeyDown="BlankAreaContextMenu_PreviewKeyDown">
            <MenuItem Header="新增话术"
                      ToolTip="在当前分类下新建一条空白话术"
                      Click="BlankAreaNewPhrase_Click" />
            <MenuItem Header="新增二级分类"
                      ToolTip="在当前一级分类下新建二级分类"
                      Click="BlankAreaNewSubCategory_Click" />
        </ContextMenu>

        <!-- 设置入口仅在话术库底部应用栏使用：基于 Secondary 保留全局焦点、悬停和按下反馈，
             以 36px 圆角描边提升入口辨识度而不影响其他图标按钮。 -->
        <Style x:Key="Style.Library.SettingsButton"
               TargetType="Button"
               BasedOn="{StaticResource Style.Button.Secondary}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayout"
          Focusable="True"
          KeyboardNavigation.IsTabStop="False"
          PreviewMouseLeftButtonDown="RootLayout_PreviewMouseLeftButtonDown"
          PreviewMouseRightButtonDown="RootLayout_PreviewMouseRightButtonDown"
          PreviewKeyDown="RootLayout_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Category Chips -->
            <RowDefinition Height="*" />      <!-- Phrase List -->
            <RowDefinition Height="Auto" />   <!-- Search Footer -->
            <RowDefinition Height="Auto" />   <!-- App Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Category Filter Bar（一级 chips 横向，自动换行）。垂直内边距收窄，缩小标题区与列表内容区间距 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Default}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="{StaticResource Thickness.Border.Bottom}"
                Padding="{StaticResource Thickness.Library.Header}">
            <StackPanel Orientation="Horizontal">
                <!-- 一级分类 chips 列表 —— ListBox + 横向 Wrap 面板，支持 ListBoxItem 拖拽事件 -->
                <ListBox x:Name="CategoryChipsList"
                         Background="Transparent" BorderThickness="0" Padding="{StaticResource Thickness.None}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding TopCategories}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CategoryChip_PreviewMouseLeftButtonDown" />
                            <EventSetter Event="PreviewMouseMove" Handler="CategoryChip_PreviewMouseMove" />
                            <EventSetter Event="DragEnter" Handler="CategoryChip_DragOver" />
                            <EventSetter Event="DragOver" Handler="CategoryChip_DragOver" />
                            <EventSetter Event="Drop" Handler="CategoryChip_Drop" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItem}">
                            <ToggleButton Style="{StaticResource Style.Library.CategoryChip}"
                                          Margin="{StaticResource Thickness.Gap.Inline.SM}"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ContextMenu="{StaticResource CategoryChipContextMenu}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding Id}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 新建一级 "+" -->
                <Button Style="{StaticResource Style.Button.Secondary.Compact}"
                        Margin="{StaticResource Thickness.None}" VerticalAlignment="Center"
                        Command="{Binding NewCategoryCommand}"
                        ToolTip="新建一级分类" Content="+" />
            </StackPanel>
        </Border>

        <!-- 2. Phrase List（内联嵌套树）。列表容器不再保留左右内边距，由行内列宽/边距直接控制。 -->
        <Grid Grid.Row="1">
            <ListBox x:Name="PhraseList" Grid.Row="1"
                     Padding="{StaticResource Thickness.None}"
                     ItemsSource="{Binding VisibleItems}"
                     SelectedItem="{Binding SelectedPhrase, Mode=TwoWay}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderThickness="0" Background="{DynamicResource Brush.Surface.Default}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionMode="Single"
                     ItemTemplateSelector="{StaticResource PhraseRowSelector}"
                     MouseDoubleClick="PhraseList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListItem.Phrase.Compact}">
                        <Setter Property="Padding" Value="{StaticResource Thickness.Library.PhraseRow.Horizontal}" />
                        <!-- 拖拽排序仍由话术库宿主处理；共享样式只负责行的视觉状态。 -->
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PhraseItem_PreviewMouseLeftButtonDown" />
                        <EventSetter Event="PreviewMouseMove" Handler="PhraseItem_PreviewMouseMove" />
                        <EventSetter Event="DragEnter" Handler="PhraseItem_DragOver" />
                        <EventSetter Event="DragOver" Handler="PhraseItem_DragOver" />
                        <EventSetter Event="Drop" Handler="PhraseItem_Drop" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSubHeader}" Value="True">
                                <Setter Property="Height" Value="{StaticResource Size.Library.SubHeader.Height}" />
                                <Setter Property="MinHeight" Value="{StaticResource Size.Library.SubHeader.Height}" />
                                <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
                                <Setter Property="Margin" Value="{StaticResource Thickness.None}" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <shared:StatePresenter StateKind="{x:Static shared:StateKind.Loading}"
                                   Title="正在加载话术"
                                   Description="正在读取话术库，请稍候。"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <shared:StatePresenter StateKind="{x:Static shared:StateKind.Error}"
                                   Title="话术库加载失败"
                                   Description="{Binding StatusMessage}"
                                   ActionText="重试"
                                   ActionCommand="{Binding RetryLoadCommand}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <shared:StatePresenter StateKind="{x:Static shared:StateKind.Empty}"
                                   Title="{Binding EmptyStateTitle}"
                                   Description="{Binding EmptyStateDescription}"
                                   ActionText="新建话术"
                                   ActionCommand="{Binding NewCommand}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- 搜索时只遮住分类栏与主列表；搜索栏和结果 Popup 仍保持可操作。 -->
        <Border x:Name="SearchBackdrop"
                Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="20"
                Background="{DynamicResource Brush.Overlay}"
                Opacity="0.45"
                Visibility="{Binding IsSearchResultVisible, Converter={StaticResource BoolToVisibility}}" />

        <!-- 3. Search Footer（左下角不再渲染计数信息；上下间距已压缩为紧凑布局） -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Default}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="{StaticResource Thickness.Border.Top}"
                Padding="{StaticResource Thickness.Library.Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Style.Input.Search}"
                              Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                              TextChanged="SearchBox_TextChanged"
                              KeyDown="SearchBox_KeyDown"
                              GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                              LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                               AutomationProperties.Name="话术搜索"
                              Tag="搜索标题、正文或拼音...">
                    </TextBox>
                     <Popup x:Name="SearchHistoryPopup"
                            PlacementTarget="{Binding ElementName=SearchBox}"
                            Placement="Top"
                            VerticalOffset="-4"
                            StaysOpen="False"
                            AllowsTransparency="True"
                            Width="{Binding ActualWidth, ElementName=SearchBox}"
                            PopupAnimation="Fade"
                            LostKeyboardFocus="SearchHistoryPopup_LostKeyboardFocus">
                         <shared:SearchHistoryView x:Name="SearchHistoryPanel"
                                                   QuerySelected="SearchHistoryPanel_QuerySelected"
                                                   ClearRequested="SearchHistoryPanel_ClearRequested" />
                     </Popup>
                     <Popup x:Name="SearchResultsPopup"
                            PlacementTarget="{Binding ElementName=SearchBox}"
                            Placement="Top"
                            VerticalOffset="-4"
                            StaysOpen="True"
                            AllowsTransparency="True"
                            Width="{Binding ActualWidth, ElementName=SearchBox}"
                            PopupAnimation="Fade">
                         <Border Style="{StaticResource Style.Popup.Surface}"
                                 Padding="{StaticResource Thickness.None}"
                                 MaxHeight="{StaticResource Size.Library.SearchResults.MaximumHeight}">
                             <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="*" />
                                 </Grid.RowDefinitions>
                                 <Border Grid.Row="0"
                                         Padding="{StaticResource Thickness.Control.Input}"
                                         BorderBrush="{DynamicResource Brush.Border.Default}"
                                         BorderThickness="{StaticResource Thickness.Border.Bottom}">
                                     <Grid>
                                         <TextBlock Text="搜索结果"
                                                    Style="{StaticResource Style.Text.Caption}"
                                                    VerticalAlignment="Center" />
                                         <Button HorizontalAlignment="Right"
                                                 Style="{StaticResource Style.Button.Icon}"
                                                 Foreground="{DynamicResource Brush.Status.Error}"
                                                 Click="ClearSearch_Click"
                                                 ToolTip="清空搜索"
                                                 AutomationProperties.Name="清空搜索">
                                             <TextBlock Text="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                         </Button>
                                     </Grid>
                                 </Border>
                                 <Grid Grid.Row="1" MinHeight="{StaticResource Size.Library.SearchResult.MinimumHeight}">
                                     <ListBox x:Name="SearchResultsList"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              ItemsSource="{Binding SearchResults}"
                                              ItemTemplate="{StaticResource SearchResultRowTemplate}"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                                              PreviewKeyDown="SearchResultsList_PreviewKeyDown">
                                         <ListBox.ItemContainerStyle>
                                             <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListItem.Phrase.Compact}">
                                                 <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
                                                 <Setter Property="Margin" Value="{StaticResource Thickness.None}" />
                                                 <Setter Property="Height" Value="{StaticResource Size.Phrase.Row.Compact}" />
                                                 <Setter Property="MinHeight" Value="{StaticResource Size.Library.SearchResult.MinimumHeight}" />
                                             </Style>
                                         </ListBox.ItemContainerStyle>
                                     </ListBox>
                                     <shared:StatePresenter StateKind="{x:Static shared:StateKind.Loading}"
                                                            Title="正在搜索"
                                                            Description="正在查找匹配话术，请稍候。"
                                                            Visibility="{Binding IsSearchBusy, Converter={StaticResource BoolToVisibility}}" />
                                     <shared:StatePresenter StateKind="{x:Static shared:StateKind.Error}"
                                                            Title="搜索失败"
                                                            Description="{Binding StatusMessage}"
                                                            Visibility="{Binding HasSearchError, Converter={StaticResource BoolToVisibility}}" />
                                     <shared:StatePresenter StateKind="{x:Static shared:StateKind.Empty}"
                                                            Title="没有找到匹配话术"
                                                            Description="换个关键词试试。"
                                                            Visibility="{Binding IsSearchResultEmpty, Converter={StaticResource BoolToVisibility}}" />
                                 </Grid>
                             </Grid>
                         </Border>
                     </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. App Footer（品牌 + 设置） -->
        <Border Grid.Row="3" Height="{StaticResource Size.Library.Footer.Height}"
                Background="{DynamicResource Brush.Surface.Default}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="{StaticResource Thickness.Border.Top}"
                Padding="{StaticResource Thickness.Library.Footer}"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 左下角品牌位与窗口、任务栏和托盘统一使用仓库内嵌的用户 ICO 资源。 -->
                    <Image Source="{StaticResource Image.Brand.AppIcon}"
                           Width="{StaticResource Size.Library.BrandIcon}" Height="{StaticResource Size.Library.BrandIcon}" Stretch="Uniform"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="闪语应用图标" />
                    <TextBlock Text="闪语" Style="{StaticResource Style.Text.Label}"
                               Margin="{StaticResource Thickness.Gap.Inline.SM}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource Style.Library.SettingsButton}"
                        VerticalAlignment="Center"
                        ToolTip="设置"
                        AutomationProperties.Name="设置"
                        Command="{Binding OpenSettingsCommand}">
                    <!-- 使用矢量齿轮，避免依赖系统字体的 Unicode 字形差异。 -->
                    <Viewbox Width="{StaticResource Size.Library.SettingsIcon}" Height="{StaticResource Size.Library.SettingsIcon}" IsHitTestVisible="False">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12S19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.53,5.05 19.28,4.96 19.05,5.05L16.56,6.05C16.05,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.95,5.65 7.44,6.05L4.95,5.05C4.72,4.96 4.47,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12S4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.47,18.95 4.72,19.04 4.95,18.95L7.44,17.95C7.95,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.05,18.35 16.56,17.95L19.05,18.95C19.28,19.04 19.53,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98ZM12,15.5A3.5,3.5 0 1 1 12,8A3.5,3.5 0 0 1 12,15.5Z" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
