<UserControl x:Class="QuickPhrase.Desktop.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:QuickPhrase.Desktop.ViewModels"
             xmlns:designSystem="clr-namespace:QuickPhrase.Desktop.DesignSystem.Components"
             mc:Ignorable="d">
    <Grid Style="{StaticResource Style.Surface.Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Size.Settings.Sidebar.GridLength}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航只负责模块切换；布局、焦点和选中状态统一来自全局列表样式。 -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Surface.Default}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="{StaticResource Thickness.Border.Right}">
            <Grid Margin="{StaticResource Thickness.Settings.Navigation}">
                <ListBox x:Name="SettingsNavigation"
                         BorderThickness="{StaticResource Thickness.None}"
                         Background="{DynamicResource Brush.Surface.Default}"
                         SelectedIndex="0"
                         SelectionMode="Single"
                         SelectionChanged="SettingsNavigation_SelectionChanged"
                         KeyboardNavigation.TabNavigation="Local"
                         AutomationProperties.Name="设置模块导航">
                    <ListBoxItem Style="{StaticResource Style.ListItem.Navigation}" Content="通用" AutomationProperties.Name="通用设置" />
                    <ListBoxItem Style="{StaticResource Style.ListItem.Navigation}" Content="快捷键" AutomationProperties.Name="快捷键设置" />
                    <ListBoxItem Style="{StaticResource Style.ListItem.Navigation}" Content="发送行为" AutomationProperties.Name="发送行为设置" />
                    <ListBoxItem Style="{StaticResource Style.ListItem.Navigation}" Content="应用适配" AutomationProperties.Name="应用适配设置" />
                    <ListBoxItem Style="{StaticResource Style.ListItem.Navigation}" Content="企业同步" AutomationProperties.Name="企业同步设置" />
                    <ListBoxItem Style="{StaticResource Style.ListItem.Navigation}" Content="数据管理" AutomationProperties.Name="数据管理设置" />
                </ListBox>
            </Grid>
        </Border>

        <!-- 所有模块共享同一阅读宽度；SettingItem 只承载视觉与无障碍语义，保存仍由 ViewModel 即时完成。 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          Padding="{StaticResource Thickness.None}"
                          AutomationProperties.Name="当前设置内容">
                <Grid MaxWidth="{StaticResource Size.Settings.Content.Maximum}"
                      HorizontalAlignment="Stretch"
                      Margin="{StaticResource Thickness.Settings.Page}">
                    <!-- 通用 -->
                    <Border x:Name="GeneralSection" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="通用" Style="{StaticResource Style.Text.Title.Large}" />
                            <TextBlock Text="控制闪语的启动方式和窗口行为。"
                                       Style="{StaticResource Style.Text.Body.Small}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Thickness.Settings.HeaderDescription}" />

                            <TextBlock Text="启动与窗口"
                                       Style="{StaticResource Style.Text.Title.Small}"
                                       Margin="{StaticResource Thickness.Settings.SectionTitle}" />
                            <Border Style="{StaticResource Style.Setting.Group}"
                                    Margin="{StaticResource Thickness.Section}">
                                <StackPanel>
                                    <designSystem:SettingItem Title="开机启动"
                                                              Description="登录 Windows 后自动启动 QuickPhrase"
                                                              ShowDivider="True">
                                        <designSystem:SettingItem.ControlContent>
                                            <CheckBox Style="{StaticResource Style.Switch.Default}"
                                                      IsChecked="{Binding LaunchOnStartup}"
                                                      VerticalAlignment="Center" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                    <designSystem:SettingItem Title="关闭窗口后驻留托盘"
                                                              Description="关闭主窗口不退出程序，保留在系统托盘"
                                                              ShowDivider="True">
                                        <designSystem:SettingItem.ControlContent>
                                            <CheckBox Style="{StaticResource Style.Switch.Default}"
                                                      IsChecked="{Binding StayInTrayOnClose}"
                                                      VerticalAlignment="Center" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                    <designSystem:SettingItem Title="启动时最小化"
                                                              Description="启动后直接进入托盘，不打开主窗口">
                                        <designSystem:SettingItem.ControlContent>
                                            <CheckBox Style="{StaticResource Style.Switch.Default}"
                                                      IsChecked="{Binding StartMinimized}"
                                                      VerticalAlignment="Center" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="使用引导"
                                       Style="{StaticResource Style.Text.Title.Small}"
                                       Margin="{StaticResource Thickness.Settings.SectionTitle}" />
                            <Border Style="{StaticResource Style.Setting.Group}">
                                <designSystem:SettingItem Title="重新体验使用引导"
                                                          Description="重新体验创建分类、添加话术和使用闪念的步骤。已有数据会被保留。">
                                    <designSystem:SettingItem.ControlContent>
                                        <Button Style="{StaticResource Style.Button.Secondary}"
                                                Content="重新开始使用引导"
                                                Command="{Binding RestartOnboardingCommand}"
                                                VerticalAlignment="Center" />
                                    </designSystem:SettingItem.ControlContent>
                                </designSystem:SettingItem>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 快捷键 -->
                    <Border x:Name="HotkeysSection" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="快捷键" Style="{StaticResource Style.Text.Title.Large}" />
                            <TextBlock Text="使用全局快捷键快速打开闪念。"
                                       Style="{StaticResource Style.Text.Body.Small}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Thickness.Settings.HeaderDescription}" />
                            <TextBlock Text="闪念"
                                       Style="{StaticResource Style.Text.Title.Small}"
                                       Margin="{StaticResource Thickness.Settings.SectionTitle}" />
                            <Border Style="{StaticResource Style.Setting.Group}">
                                <designSystem:SettingItem Title="打开闪念"
                                                          Description="使用快捷键打开闪念">
                                    <designSystem:SettingItem.ControlContent>
                                        <StackPanel HorizontalAlignment="Right">
                                            <designSystem:ShortcutInput Chord="{Binding LauncherShortcut}"
                                                                        ErrorMessage="{Binding ErrorMessage}"
                                                                        IsHitTestVisible="False"
                                                                        Focusable="False"
                                                                        HorizontalAlignment="Right"
                                                                        Margin="{StaticResource Thickness.Gap.Stack.SM}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource Style.Button.Secondary.Compact}"
                                                        Content="Alt + Space"
                                                        Margin="{StaticResource Thickness.Gap.Inline.SM}"
                                                        Click="ApplyRecommendedShortcut_Click" />
                                                <Button Style="{StaticResource Style.Button.Secondary.Compact}"
                                                        Content="Ctrl + Space"
                                                        Margin="{StaticResource Thickness.Gap.Inline.SM}"
                                                        Click="ApplyAlternateShortcut_Click" />
                                                <Button Style="{StaticResource Style.Button.Secondary.Compact}"
                                                        Content="自定义"
                                                        Click="EditCustomShortcut_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </designSystem:SettingItem.ControlContent>
                                </designSystem:SettingItem>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 发送行为 -->
                    <Border x:Name="DeliverySection" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="发送行为" Style="{StaticResource Style.Text.Title.Large}" />
                            <TextBlock Text="控制话术插入与发送时的兼容行为。"
                                       Style="{StaticResource Style.Text.Body.Small}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Thickness.Settings.HeaderDescription}" />
                            <TextBlock Text="投递策略"
                                       Style="{StaticResource Style.Text.Title.Small}"
                                       Margin="{StaticResource Thickness.Settings.SectionTitle}" />
                            <Border Style="{StaticResource Style.Setting.Group}">
                                <StackPanel>
                                    <designSystem:SettingItem Title="插入并发送免确认"
                                                              Description="风险选项：Ctrl+Enter 插入并发送时跳过每次确认；目标中已有草稿可能一并发送"
                                                              ShowDivider="True">
                                        <designSystem:SettingItem.ControlContent>
                                            <CheckBox Style="{StaticResource Style.Switch.Default}"
                                                      IsChecked="{Binding QuickSendWithoutConfirmation}"
                                                      VerticalAlignment="Center" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                    <designSystem:SettingItem Title="剪贴板兼容模式"
                                                              Description="对部分目标使用受保护剪贴板粘贴">
                                        <designSystem:SettingItem.ControlContent>
                                            <CheckBox Style="{StaticResource Style.Switch.Default}"
                                                      IsChecked="{Binding ClipboardCompatibilityMode}"
                                                      VerticalAlignment="Center" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 应用适配：所有前台应用都可呼出闪念；这里仅说明拥有专属投递优化的应用。 -->
                    <Border x:Name="AdaptersSection" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="应用适配" Style="{StaticResource Style.Text.Title.Large}" />
                            <TextBlock Text="所有前台应用都可以使用全局快捷键打开闪念。已适配应用会使用专属的插入和发送安全校验。"
                                       Style="{StaticResource Style.Text.Body.Small}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Thickness.Settings.HeaderDescription}" />
                            <TextBlock Text="已适配的应用"
                                       Style="{StaticResource Style.Text.Title.Small}"
                                       Margin="{StaticResource Thickness.Settings.SectionTitle}" />
                            <Border Style="{StaticResource Style.Setting.Group}">
                                <designSystem:SettingItem Title="企业微信"
                                                          Description="已进行专属插入与插入并发送安全优化">
                                    <designSystem:SettingItem.ControlContent>
                                        <TextBlock Text="已适配"
                                                   Style="{StaticResource Style.Text.Body.Small}"
                                                   Foreground="{DynamicResource Brush.Accent.Primary}"
                                                   VerticalAlignment="Center" />
                                    </designSystem:SettingItem.ControlContent>
                                </designSystem:SettingItem>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 企业同步：默认本地模式；密码只进入当前连接命令，不持久化。 -->
                    <Border x:Name="EnterpriseSyncSection"
                            Visibility="Collapsed"
                            DataContext="{Binding EnterpriseSync}">
                        <StackPanel>
                            <TextBlock Text="企业同步" Style="{StaticResource Style.Text.Title.Large}" />
                            <TextBlock Text="连接企业内网中的闪语中心；未连接或服务器离线时，本地话术仍可正常使用。"
                                       Style="{StaticResource Style.Text.Body.Small}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource Thickness.Settings.HeaderDescription}" />
                            <Border Style="{StaticResource Style.Setting.Group}">
                                <StackPanel>
                                    <TextBlock Text="{Binding HttpRiskMessage}"
                                               Foreground="{DynamicResource Brush.Status.Warning}"
                                               Style="{StaticResource Style.Text.Body.Small}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource Thickness.Settings.DataStatus}" />
                                    <TextBlock Text="Hub 地址" Style="{StaticResource Style.Text.Caption}" Margin="{StaticResource Thickness.Settings.SyncFieldLabel}" />
                                    <TextBox Style="{StaticResource Style.Input.Default}"
                                             Text="{Binding HubAddress, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Hub 地址" />
                                    <TextBlock Text="账号" Style="{StaticResource Style.Text.Caption}"
                                               Margin="{StaticResource Thickness.Settings.SyncFieldLabel}" />
                                    <TextBox Style="{StaticResource Style.Input.Default}"
                                             Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="企业账号" />
                                    <TextBlock Text="密码" Style="{StaticResource Style.Text.Caption}"
                                               Margin="{StaticResource Thickness.Settings.SyncFieldLabel}" />
                                    <PasswordBox x:Name="EnterprisePassword"
                                                 Style="{StaticResource Style.Input.Password}"
                                                 PasswordChanged="EnterprisePassword_PasswordChanged"
                                                 AutomationProperties.Name="企业账号密码" />
                                    <TextBlock Text="设备名称" Style="{StaticResource Style.Text.Caption}"
                                               Margin="{StaticResource Thickness.Settings.SyncFieldLabel}" />
                                    <TextBox Style="{StaticResource Style.Input.Default}"
                                             Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="设备名称" />
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.Settings.SectionTitle}">
                                        <Button Style="{StaticResource Style.Button.Primary}" Content="连接 / 重新认证" Command="{Binding ConnectCommand}" />
                                        <Button Style="{StaticResource Style.Button.Secondary}" Content="立即同步" Command="{Binding SynchronizeCommand}" Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                                        <Button Style="{StaticResource Style.Button.Secondary}" Content="断开连接" Command="{Binding DisconnectCommand}" Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Style.Text.Body.Small}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LastSynchronizedText, StringFormat=最后同步：{0}}" Style="{StaticResource Style.Text.Caption}" />
                                    <TextBlock Text="{Binding ReleaseNumber, StringFormat=企业发布号：{0}}" Style="{StaticResource Style.Text.Caption}" />
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Error}" Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TraceId, StringFormat=TraceId：{0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TraceId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding TraceId}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Style="{StaticResource Style.Button.Danger}"
                                            Content="清除本机企业缓存"
                                            HorizontalAlignment="Left"
                                            Margin="{StaticResource Thickness.Settings.SectionTitle}"
                                            Click="ClearEnterpriseCache_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 数据管理：只提供本地话术包入口，不改变既有数据边界。 -->
                    <Border x:Name="DataManagementSection" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="数据管理" Style="{StaticResource Style.Text.Title.Large}" />
                            <TextBlock Text="管理本机 QuickPhrase 的话术数据。"
                                       Style="{StaticResource Style.Text.Body.Small}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Thickness.Settings.HeaderDescription}" />
                            <TextBlock Text="话术包"
                                       Style="{StaticResource Style.Text.Title.Small}"
                                       Margin="{StaticResource Thickness.Settings.SectionTitle}" />
                            <Border Style="{StaticResource Style.Setting.Group}">
                                <Border.Resources>
                                    <!-- 数据管理反馈为空时必须折叠，避免文本 Margin 在卡片底部形成无意义占位。 -->
                                    <Style x:Key="Style.Settings.DataFeedback"
                                           TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource Style.Text.Caption}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Resources>
                                <StackPanel>
                                    <designSystem:SettingItem Title="导入话术包"
                                                              Description="从本机话术包添加内容，不影响现有分类。"
                                                              ShowDivider="True">
                                        <designSystem:SettingItem.ControlContent>
                                            <Button Style="{StaticResource Style.Button.Secondary}"
                                                    Content="导入"
                                                    Command="{Binding DataManagement.RequestImportCommand}"
                                                    MinWidth="{StaticResource Size.Button.Action.MinimumWidth}" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                    <designSystem:SettingItem Title="导出话术包"
                                                              Description="将当前话术导出为本地话术包。">
                                        <designSystem:SettingItem.ControlContent>
                                            <Button Style="{StaticResource Style.Button.Secondary}"
                                                    Content="导出"
                                                    Command="{Binding DataManagement.RequestExportCommand}"
                                                    MinWidth="{StaticResource Size.Button.Action.MinimumWidth}" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                    <TextBlock Text="{Binding DataManagement.StatusMessage}"
                                               Style="{StaticResource Style.Settings.DataFeedback}"
                                               Margin="{StaticResource Thickness.Settings.DataStatus}" />
                                    <TextBlock Text="{Binding DataManagement.ErrorMessage}"
                                               Foreground="{DynamicResource Brush.Status.Error}"
                                               Style="{StaticResource Style.Settings.DataFeedback}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource Thickness.Settings.DataError}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="批量导入（CSV）"
                                       Style="{StaticResource Style.Text.Title.Small}"
                                       Margin="{StaticResource Thickness.Settings.SectionTitle}" />
                            <Border Style="{StaticResource Style.Setting.Group}">
                                <StackPanel>
                                    <designSystem:SettingItem Title="下载导入模板"
                                                              Description="模板使用 UTF-8 CSV 格式，可直接用 Excel 编辑。"
                                                              ShowDivider="True">
                                        <designSystem:SettingItem.ControlContent>
                                            <Button Style="{StaticResource Style.Button.Secondary}"
                                                    Content="下载模板"
                                                    Command="{Binding DataManagement.RequestBatchImportTemplateCommand}"
                                                    MinWidth="{StaticResource Size.Button.Action.MinimumWidth}" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                    <designSystem:SettingItem Title="导入 CSV 话术"
                                                              Description="列顺序固定为一级分类、二级分类、话术标题、话术内容；固定示例行会自动忽略。">
                                        <designSystem:SettingItem.ControlContent>
                                            <Button Style="{StaticResource Style.Button.Secondary}"
                                                    Content="批量导入"
                                                    Command="{Binding DataManagement.RequestBatchImportCommand}"
                                                    MinWidth="{StaticResource Size.Button.Action.MinimumWidth}" />
                                        </designSystem:SettingItem.ControlContent>
                                    </designSystem:SettingItem>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- 即时保存状态固定在内容区底部，不遮挡模块滚动内容。 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Surface.Default}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="{StaticResource Thickness.Border.Top}"
                    Padding="{StaticResource Thickness.Settings.Footer}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="正在应用设置…"
                               Style="{StaticResource Style.Text.Caption}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Status.Error}"
                               Style="{StaticResource Style.Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource Thickness.Gap.Inline.SM}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
