<UserControl x:Class="QuickPhrase.Desktop.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:QuickPhrase.Desktop.ViewModels"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <TextBlock Text="设置" Style="{StaticResource TextH1}" />
        </Border>

        <!-- 设置主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <!-- 通用 -->
                <TextBlock Text="通用" Style="{StaticResource TextH2}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="开机启动" Style="{StaticResource TextBody}" />
                        <TextBlock Text="登录 Windows 后自动启动 QuickPhrase" Style="{StaticResource TextCaption}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Grid.Column="1" IsChecked="{Binding LaunchOnStartup}" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,12,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="关闭窗口后驻留托盘" Style="{StaticResource TextBody}" />
                        <TextBlock Text="关闭主窗口不退出程序，保留在系统托盘" Style="{StaticResource TextCaption}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Grid.Column="1" IsChecked="{Binding StayInTrayOnClose}" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,12,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="启动时最小化" Style="{StaticResource TextBody}" />
                        <TextBlock Text="启动后直接进入托盘，不打开主窗口" Style="{StaticResource TextCaption}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Grid.Column="1" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" />
                </Grid>

                <!-- 使用引导：只请求应用层重新打开向导，不在设置页删除或创建业务数据。 -->
                <Border Background="{StaticResource AppBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,16,0,4">
                    <StackPanel>
                        <TextBlock Text="使用引导" Style="{StaticResource TextBody}" />
                        <TextBlock Text="重新体验创建分类、添加话术和使用闪念的步骤。已有数据会被保留。"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="重新开始使用引导"
                                Command="{Binding RestartOnboardingCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16,0,4" />

                <!-- 快捷键 -->
                <TextBlock Text="快捷键" Style="{StaticResource TextH2}" Margin="0,8,0,12" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="闪念" Style="{StaticResource TextBody}" />
                        <TextBlock Text="按快捷键打开闪念" Style="{StaticResource TextCaption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource ShortcutBadge}">
                            <TextBlock Text="{Binding LauncherShortcutDisplay, TargetNullValue=未设置}" Style="{StaticResource TextBody}" />
                        </Border>
                        <Button x:Name="EditLauncherShortcut" Style="{StaticResource SecondaryButton}" Content="修改"
                                Margin="8,0,0,0" Click="EditLauncherShortcut_Click" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16,0,4" />

                <!-- 发送行为 -->
                <TextBlock Text="发送行为" Style="{StaticResource TextH2}" Margin="0,8,0,12" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="自动发送" Style="{StaticResource TextBody}" />
                        <TextBlock Text="插入后自动发送（当前目标不支持时不会开启）" Style="{StaticResource TextCaption}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Grid.Column="1" IsChecked="{Binding AutoSend}" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,12,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="剪贴板兼容模式" Style="{StaticResource TextBody}" />
                        <TextBlock Text="对部分目标使用受保护剪贴板粘贴" Style="{StaticResource TextCaption}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Grid.Column="1" IsChecked="{Binding ClipboardCompatibilityMode}" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16,0,4" />

                <!-- 应用适配 -->
                <TextBlock Text="应用适配" Style="{StaticResource TextH2}" Margin="0,8,0,12" />

                <ItemsControl ItemsSource="{Binding Adapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdapterToggleItem}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,20,0,4" />

                <!-- 数据管理：只提供本地话术包入口，不混入标签、颜色或设置数据。 -->
                <TextBlock Text="数据管理" Style="{StaticResource TextH2}" Margin="0,8,0,4" />
                <TextBlock Text="管理本机 QuickPhrase 的话术数据。" Style="{StaticResource TextCaption}" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="导入话术包"
                            Command="{Binding DataManagement.RequestImportCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="导出话术包"
                            Command="{Binding DataManagement.RequestExportCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding DataManagement.StatusMessage}" Style="{StaticResource TextCaption}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding DataManagement.ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="保存" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
