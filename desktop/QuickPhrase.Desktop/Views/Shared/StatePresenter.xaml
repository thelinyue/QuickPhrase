<UserControl x:Class="QuickPhrase.Desktop.Views.Shared.StatePresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickPhrase.Desktop.Views.Shared"
             x:Name="Presenter"
             MinHeight="{StaticResource Size.StatePresenter.MinimumHeight}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource Thickness.XXL}">
        <TextBlock Text="○" Style="{StaticResource Style.Text.Title.Large}" Foreground="{DynamicResource Brush.Text.Muted}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Title, ElementName=Presenter}"
                   Style="{StaticResource Style.Text.Title.Small}" HorizontalAlignment="Center"
                   Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" />
        <TextBlock Text="{Binding Description, ElementName=Presenter}"
                   Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" Margin="{StaticResource Thickness.Gap.Stack.Before.XS}" />
        <Button Content="{Binding ActionText, ElementName=Presenter}"
                Command="{Binding ActionCommand, ElementName=Presenter}"
                Style="{StaticResource Style.Button.Secondary.Compact}"
                HorizontalAlignment="Center" Margin="{StaticResource Thickness.Gap.Stack.Before.MD}"
                Visibility="{Binding IsActionVisible, ElementName=Presenter, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
