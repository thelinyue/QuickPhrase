<UserControl x:Class="QuickPhrase.Desktop.Views.Shared.StatePresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickPhrase.Desktop.Views.Shared"
             x:Name="Presenter"
             MinHeight="84">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,16">
        <TextBlock Text="○" FontSize="20" Foreground="{StaticResource TextTertiaryBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Title, ElementName=Presenter}"
                   Style="{StaticResource TextListTitle}" HorizontalAlignment="Center"
                   Margin="0,8,0,0" />
        <TextBlock Text="{Binding Description, ElementName=Presenter}"
                   Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" />
        <Button Content="{Binding ActionText, ElementName=Presenter}"
                Command="{Binding ActionCommand, ElementName=Presenter}"
                Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Center" Margin="0,12,0,0"
                Visibility="{Binding IsActionVisible, ElementName=Presenter, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
