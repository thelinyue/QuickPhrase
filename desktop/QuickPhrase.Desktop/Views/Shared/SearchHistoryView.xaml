<UserControl x:Class="QuickPhrase.Desktop.Views.Shared.SearchHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="历史搜索记录">
    <Border Padding="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusPopup}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                <Button x:Name="ClearButton"
                        DockPanel.Dock="Left"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource DangerBrush}"
                        Click="ClearButton_Click"
                        AutomationProperties.Name="清除全部历史搜索">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="清除全部" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="历史搜索"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource MutedTextBrush}"
                           Style="{StaticResource TextCaption}"
                           VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer Grid.Row="1"
                          MaxHeight="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="HistoryList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedValuePath="Query"
                         SelectionChanged="HistoryList_SelectionChanged"
                         AutomationProperties.Name="历史关键词列表">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card"
                                                Padding="10,6"
                                                Background="{StaticResource AppBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusXs}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Query}"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="260"
                                       AutomationProperties.Name="{Binding Query}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText"
                       Grid.Row="1"
                       Text="暂无历史搜索"
                       Foreground="{StaticResource MutedTextBrush}"
                       Style="{StaticResource TextCaption}"
                       Visibility="Collapsed"
                       AutomationProperties.Name="暂无历史搜索" />
        </Grid>
    </Border>
</UserControl>
