<UserControl x:Class="QuickPhrase.Desktop.Views.Shared.SearchHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="历史搜索记录">
    <Border Background="Transparent" BorderThickness="0" Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="最近搜索" Style="{StaticResource Style.Text.Caption}" VerticalAlignment="Center" />

            <Button x:Name="ClearButton"
                    Grid.Column="2"
                    Style="{StaticResource Style.Button.Icon}"
                    Foreground="{DynamicResource Brush.Status.Error}"
                    Click="ClearButton_Click"
                    ToolTip="清除全部历史搜索"
                    ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="清除全部历史搜索">
                <TextBlock Text="&#xE74D;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource Typography.Title.Small.FontSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <Grid x:Name="HistoryHost" Grid.Column="1" Margin="{StaticResource Thickness.Gap.Inline.SM}">
                <ListBox x:Name="HistoryList"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectedValuePath="Query"
                         SelectionChanged="HistoryList_SelectionChanged"
                         AutomationProperties.Name="历史关键词列表"
                         ItemContainerStyle="{StaticResource Style.ListItem.SearchHistory}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Query}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="{Binding Query}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           Text="暂无历史搜索"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Style="{StaticResource Style.Text.Caption}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           AutomationProperties.Name="暂无历史搜索" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
