<UserControl x:Class="QuickPhrase.Desktop.Views.Shared.SearchHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="历史搜索记录">
    <Border Style="{StaticResource Style.Popup.Surface}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource Size.SearchHistory.Gutter.GridLength}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ClearButton"
                    Grid.Column="0"
                    Style="{StaticResource Style.Button.Icon}"
                    Foreground="{DynamicResource Brush.Status.Error}"
                    Click="ClearButton_Click"
                    ToolTip="清除全部历史搜索"
                    ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="清除全部历史搜索">
                <TextBlock Text="&#xE74D;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource Typography.Title.Small.FontSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <Grid x:Name="HistoryHost" Grid.Column="2">
                <ListBox x:Name="HistoryList"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectedValuePath="Query"
                         SelectionChanged="HistoryList_SelectionChanged"
                         AutomationProperties.Name="历史关键词列表">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"
                                         Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
                            <Setter Property="Margin" Value="{StaticResource Thickness.Gap.Inline.SM}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card"
                                                Padding="{StaticResource Thickness.XS}"
                                                Background="{DynamicResource Brush.Background.Window}"
                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                BorderThickness="{StaticResource Thickness.Border.Default}"
                                                CornerRadius="{StaticResource Radius.XS}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.State.Hover}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.State.Hover}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Query}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="{Binding Query}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           Text="暂无历史搜索"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Style="{StaticResource Style.Text.Caption}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           AutomationProperties.Name="暂无历史搜索" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
