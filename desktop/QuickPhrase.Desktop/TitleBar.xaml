<!-- 自定义标题栏：左侧品牌区（属于窗口 caption，可拖动/双击最大化/Snap），右侧系统按钮可点击 -->
<UserControl x:Class="QuickPhrase.Desktop.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickPhrase.Desktop"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <Grid Height="{StaticResource Size.TitleBar.Height}" Style="{StaticResource Style.Surface.TitleBar}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 拖动 / 双击最大化 / Snap 区域（非命中可见，走原生 caption）。 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Thickness.Gap.Inline.Before.LG}">
            <Image Source="{StaticResource Image.Brand.AppIcon}"
                   Width="{StaticResource Size.TitleBar.BrandIcon}"
                   Height="{StaticResource Size.TitleBar.BrandIcon}"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="闪语应用图标" />
            <TextBlock Text="闪语 · "
                       Style="{StaticResource Style.Text.Title.Small}"
                       Margin="{StaticResource Thickness.Gap.Inline.SM}" />
            <TextBlock Text="{Binding PageTitle, RelativeSource={RelativeSource AncestorType=local:TitleBar}}"
                       Style="{StaticResource Style.Text.Title.Small}"
                       Margin="0" />
        </StackPanel>

        <!-- 系统按钮（命中可见，可点击） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="SettingsButton"
                    Style="{StaticResource Style.Button.Ghost.Compact}"
                    Width="{StaticResource Size.TitleBar.CaptionButton.Width}"
                    Click="SettingsButton_Click"
                    ToolTip="设置"
                    AutomationProperties.Name="设置"
                    Visibility="{Binding ShowSettingsButton, RelativeSource={RelativeSource AncestorType=local:TitleBar}, Converter={StaticResource BoolToVisibility}}">
                <!-- 使用矢量齿轮，避免依赖系统字体的 Unicode 字形差异。 -->
                <Viewbox Width="{StaticResource Size.TitleBar.ActionIcon}"
                         Height="{StaticResource Size.TitleBar.ActionIcon}"
                         IsHitTestVisible="False">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12S19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.53,5.05 19.28,4.96 19.05,5.05L16.56,6.05C16.05,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.95,5.65 7.44,6.05L4.95,5.05C4.72,4.96 4.47,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12S4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.47,18.95 4.72,19.04 4.95,18.95L7.44,17.95C7.95,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.05,18.35 16.56,17.95L19.05,18.95C19.28,19.04 19.53,19.04 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98ZM12,15.5A3.5,3.5 0 1 1 12,8A3.5,3.5 0 0 1 12,15.5Z" />
                </Viewbox>
            </Button>
            <Button x:Name="MinButton" Style="{StaticResource Style.Button.Ghost.Compact}"
                    Width="{StaticResource Size.TitleBar.CaptionButton.Width}" Click="MinButton_Click" Content="—" AutomationProperties.Name="最小化窗口" ToolTip="最小化" />
            <Button x:Name="MaxButton" Style="{StaticResource Style.Button.Ghost.Compact}"
                    Width="{StaticResource Size.TitleBar.CaptionButton.Width}" Click="MaxButton_Click" Content="▢" AutomationProperties.Name="最大化或还原窗口" ToolTip="最大化或还原" />
            <Button x:Name="CloseButton" Style="{StaticResource Style.Button.Ghost.Compact}"
                    Width="{StaticResource Size.TitleBar.CaptionButton.Width}" Click="CloseButton_Click" Content="✕" AutomationProperties.Name="关闭窗口" ToolTip="关闭" />
        </StackPanel>
    </Grid>
</UserControl>
