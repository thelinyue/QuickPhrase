<!--
  QuickPhrase 主题聚合入口。
  固定 Token 合并顺序确保品牌原色、语义颜色和 Brush 分层加载；运行时换肤只替换 Light/Dark 语义颜色字典。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../DesignSystem/Tokens/Typography.xaml" />
        <ResourceDictionary Source="../DesignSystem/Tokens/Thickness.xaml" />
        <ResourceDictionary Source="../DesignSystem/Tokens/Radius.xaml" />
        <ResourceDictionary Source="../DesignSystem/Tokens/Sizes.xaml" />
        <ResourceDictionary Source="../DesignSystem/Tokens/Motion.xaml" />
        <ResourceDictionary Source="../DesignSystem/Tokens/Colors.xaml" />
        <ResourceDictionary Source="../DesignSystem/Themes/Theme.Light.xaml" />
        <ResourceDictionary Source="../DesignSystem/Tokens/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
