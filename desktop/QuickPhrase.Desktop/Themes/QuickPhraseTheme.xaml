<!--
  QuickPhrase 设计系统基座 — Windows Native Productivity
  颜色 / 笔刷 / 排版 / 间距 / 圆角 / 控件高度 全部集中在此。
  数值权威来源：D:\code\闪语原型\话术库\需求设计\design-system.md（第七版）。
  本文件只定义资源，不定义控件模板（控件模板见 Controls.xaml）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         1. COLORS（原始色值，供笔刷/渐变/不透明度复用）
         对齐闪语原型 OKLCH violet-500/slate Token（hex 近似值）。
         暗色对应见 QuickPhraseTheme.Dark.xaml。
         ============================================================ -->
    <Color x:Key="AccentColor">#6D45F5</Color>          <!-- primary violet-500 -->
    <Color x:Key="AccentDarkColor">#5731E8</Color>     <!-- primary-hover violet-600 -->
    <Color x:Key="AccentSoftColor">#F5F3FF</Color>     <!-- primary-subtle violet-50 -->
    <Color x:Key="AccentRowColor">#F5F3FF</Color>      <!-- 列表选中行底 = primary-subtle -->
    <Color x:Key="BrandStartColor">#7858FF</Color>     <!-- 品牌标渐变起 violet-500 倾向 -->
    <Color x:Key="BrandEndColor">#4628C4</Color>       <!-- 品牌标渐变止 violet-700 -->
    <Color x:Key="DividerColor">#E4E4E9</Color>        <!-- border-default slate-200 -->
    <Color x:Key="BorderSubtleColor">#F1F1F4</Color>   <!-- border-subtle slate-100 -->
    <Color x:Key="MutedTextColor">#74747F</Color>      <!-- text-secondary slate-500 -->
    <Color x:Key="TextTertiaryColor">#9A9AA3</Color>   <!-- text-tertiary slate-400 -->
    <Color x:Key="AppBackgroundColor">#FAFAFC</Color>  <!-- surface-subtle slate-50 -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>        <!-- surface-base / elevated -->
    <Color x:Key="TextColor">#1C1C22</Color>           <!-- text-primary slate-900 -->
    <Color x:Key="SuccessColor">#2FA56B</Color>        <!-- success-500 -->
    <Color x:Key="WarningColor">#E0B13D</Color>        <!-- warning-500 -->
    <Color x:Key="DangerColor">#D63A3A</Color>         <!-- error-500 -->
    <Color x:Key="FocusRingColor">#9974FF</Color>      <!-- focus-ring violet-400（实色） -->
    <Color x:Key="SubHeaderBlueColor">#E9F2FC</Color>     <!-- 二级分类条固定淡蓝底（默认/展开一致） -->

    <!-- ============================================================
         2. BRUSHES
         ============================================================ -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="ListSelectedBrush" Color="{StaticResource AccentRowColor}" />
    <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrandEndColor}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="SubHeaderBlueBrush" Color="{StaticResource SubHeaderBlueColor}" />

    <!-- 固定话术颜色色板（默认白色表示无颜色；颜色值在明暗主题中保持一致） -->
    <!-- 固定话术颜色色板（默认白色表示无颜色；颜色值在明暗主题中保持一致） -->
    <SolidColorBrush x:Key="PhraseColorDefault" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PhraseColorOrange" Color="#FF8839" />
    <SolidColorBrush x:Key="PhraseColorBlue" Color="#178BFF" />
    <SolidColorBrush x:Key="PhraseColorMagenta" Color="#FF73FF" />
    <SolidColorBrush x:Key="PhraseColorPurple" Color="#AF60FF" />
    <SolidColorBrush x:Key="PhraseColorGreen" Color="#41C028" />
    <SolidColorBrush x:Key="PhraseColorPink" Color="#F67E91" />
    <SolidColorBrush x:Key="PhraseColorTeal" Color="#00A8A8" />
    <SolidColorBrush x:Key="PhraseColorTan" Color="#CB9563" />
    <SolidColorBrush x:Key="PhraseColorGray" Color="#5C6772" />

    <!-- ============================================================
         3. TYPOGRAPHY（Segoe UI Variable，中文回落微软雅黑）
         字号、行高对齐闪语原型 text-xs/sm/base/lg/xl（紧凑高密度）。
         ============================================================ -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei, PingFang SC, sans-serif</FontFamily>

    <!-- 页面标题 text-xl 20px -->
    <Style x:Key="TextH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <!-- 二级标题 text-lg 17px（模态/弹窗/分组标题） -->
    <Style x:Key="TextH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!-- Launcher 卡片主标题 17px -->
    <Style x:Key="TextLauncherTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- 话术行标题 15px / 500 weight（对齐 design-system.md text-base 15px） -->
    <Style x:Key="TextListTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 话术行/列表正文 15px（对齐 design-system.md text-base 15px） -->
    <Style x:Key="TextListBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 通用正文 text-sm 13px（Wrap） -->
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!-- text-xs 12px 次级说明 -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- 元数据 12px -->
    <Style x:Key="TextMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- eyebrow 11px 极小标签 -->
    <Style x:Key="TextEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- 等宽（序号列） -->
    <FontFamily x:Key="UiMonoFontFamily">Cascadia Mono, Consolas, Segoe UI Mono, monospace</FontFamily>
    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiMonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- ============================================================
         4. SPACING（4 / 8 / 12 / 16 / 24 栅格）
         ============================================================ -->
    <Thickness x:Key="SpaceXxs">4,4,4,4</Thickness>
    <Thickness x:Key="SpaceXs">8,8,8,8</Thickness>
    <Thickness x:Key="SpaceSm">12,12,12,12</Thickness>
    <Thickness x:Key="SpaceMd">16,16,16,16</Thickness>
    <Thickness x:Key="SpaceLg">24,24,24,24</Thickness>
    <Thickness x:Key="SpaceStackXs">0,4,0,0</Thickness>
    <Thickness x:Key="SpaceStackSm">0,8,0,0</Thickness>
    <Thickness x:Key="SpaceStackMd">0,12,0,0</Thickness>
    <Thickness x:Key="SpaceStackLg">0,16,0,0</Thickness>

    <!-- ============================================================
         5. RADIUS（小圆角，克制，≤16px）
         对齐闪语原型 radius-sm/md/lg（4 / 6 / 8）。
         ============================================================ -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusPopup">8</CornerRadius>
    <CornerRadius x:Key="RadiusLauncher">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>

    <!-- ============================================================
         6. CONTROL HEIGHTS（紧凑密度，对齐闪语原型 row-32/sub-28/btn-34/search-36）
         ============================================================ -->
    <sys:Double x:Key="ButtonHeight">34</sys:Double>
    <sys:Double x:Key="SearchBoxHeight">36</sys:Double>
    <sys:Double x:Key="CategoryItemHeight">30</sys:Double>
    <sys:Double x:Key="SettingsRowHeight">67</sys:Double>
    <sys:Double x:Key="ToggleWidth">38</sys:Double>
    <sys:Double x:Key="ToggleHeight">22</sys:Double>
    <sys:Double x:Key="LauncherCardMaxHeight">520</sys:Double>
    <sys:Double x:Key="LauncherCardMinWidth">680</sys:Double>
    <sys:Double x:Key="PhraseRowMinHeight">32</sys:Double>
    <sys:Double x:Key="SubHeaderHeight">34</sys:Double>
    <sys:Double x:Key="NavItemHeight">40</sys:Double>
    <sys:Double x:Key="AppFooterHeight">48</sys:Double>
    <sys:Double x:Key="ChipCountHeight">16</sys:Double>

</ResourceDictionary>

