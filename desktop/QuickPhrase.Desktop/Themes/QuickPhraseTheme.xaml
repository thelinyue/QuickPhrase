<!--
  QuickPhrase 设计系统基座 — Windows Native Productivity
  颜色 / 笔刷 / 排版 / 间距 / 圆角 / 控件高度 全部集中在此。
  年轻宙斯主题以天空蓝、冰川蓝、云雾白和少量金色表达品牌；不把人物插画带入生产界面。
  本文件只定义资源，不定义控件模板（控件模板见 Controls.xaml）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        1. 语义化主题 Token
        Brand/Surface/Text/State 是新代码的首选资源；Accent* 等旧 key 仅作为兼容别名。
        Light 与 Dark 共用语义名，但使用各自的对比度映射，不要求数值镜像。
    -->
    <Color x:Key="BrandPrimaryColor">#4C8DFF</Color>
    <Color x:Key="BrandPrimaryHoverColor">#3D7FEB</Color>
    <Color x:Key="BrandPrimaryPressedColor">#326FD6</Color>
    <Color x:Key="BrandIceColor">#8EC5FF</Color>
    <Color x:Key="BrandIceLightColor">#E8F4FF</Color>
    <Color x:Key="BrandGoldColor">#F5B940</Color>
    <Color x:Key="BrandGoldLightColor">#FFD76A</Color>

    <Color x:Key="WindowBackgroundColor">#F7F9FC</Color>
    <Color x:Key="NavigationBackgroundColor">#F2F6FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSecondaryColor">#F9FBFE</Color>
    <Color x:Key="BorderNormalColor">#DDE3EA</Color>
    <Color x:Key="SeparatorColor">#E8EDF3</Color>
    <Color x:Key="TextPrimaryColor">#182230</Color>
    <Color x:Key="TextSecondaryColor">#475467</Color>
    <Color x:Key="TextMutedColor">#7B8796</Color>
    <Color x:Key="TextTertiaryColor">#98A6B8</Color>
    <Color x:Key="SelectionBackgroundColor">#EAF3FF</Color>
    <Color x:Key="HoverBackgroundColor">#F3F8FF</Color>
    <Color x:Key="FocusColor">#4C8DFF</Color>
    <Color x:Key="SuccessColor">#32A66A</Color>
    <Color x:Key="WarningColor">#E9A23B</Color>
    <Color x:Key="DangerColor">#D64545</Color>
    <Color x:Key="OnBrandPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OverlayColor">#000000</Color>
    <Color x:Key="ShadowColor">#B8C7D9</Color>

    <!-- 兼容旧 XAML 的 Color key；新代码应直接使用上面的语义 key。 -->
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="AccentDarkColor">#326FD6</Color>
    <Color x:Key="AccentSoftColor">#E8F4FF</Color>
    <Color x:Key="AccentRowColor">#EAF3FF</Color>
    <Color x:Key="BrandStartColor">#8EC5FF</Color>
    <Color x:Key="BrandEndColor">#326FD6</Color>
    <Color x:Key="DividerColor">#E8EDF3</Color>
    <Color x:Key="BorderSubtleColor">#E8EDF3</Color>
    <Color x:Key="MutedTextColor">#7B8796</Color>
    <Color x:Key="AppBackgroundColor">#F7F9FC</Color>
    <Color x:Key="TextColor">#182230</Color>
    <Color x:Key="FocusRingColor">#4C8DFF</Color>
    <Color x:Key="SubHeaderBlueColor">#F3F8FF</Color>

    <!-- 2. 语义化 Brush；金色只用于收藏/品牌高光，不承担主操作。 -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource BrandPrimaryPressedColor}" />
    <SolidColorBrush x:Key="BrandIceBrush" Color="{StaticResource BrandIceColor}" />
    <SolidColorBrush x:Key="BrandIceLightBrush" Color="{StaticResource BrandIceLightColor}" />
    <SolidColorBrush x:Key="BrandGoldBrush" Color="{StaticResource BrandGoldColor}" />
    <SolidColorBrush x:Key="BrandGoldLightBrush" Color="{StaticResource BrandGoldLightColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="{StaticResource NavigationBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="BorderNormalBrush" Color="{StaticResource BorderNormalColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OnBrandPrimaryBrush" Color="{StaticResource OnBrandPrimaryColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="ThemeShadowBrush" Color="{StaticResource ShadowColor}" />

    <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrandEndColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- 兼容旧 XAML 的 Brush key；新代码应优先使用语义化 Brush。 -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource BrandPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource BrandIceLightColor}" />
    <SolidColorBrush x:Key="ListSelectedBrush" Color="{StaticResource SelectionBackgroundColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="SubHeaderBlueBrush" Color="{StaticResource HoverBackgroundColor}" />

    <!-- 固定话术颜色色板与应用主题分离，保持既有业务色值和持久化 key。 -->
    <SolidColorBrush x:Key="PhraseColorDefault" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PhraseColorOrange" Color="#FF8839" />
    <SolidColorBrush x:Key="PhraseColorBlue" Color="#178BFF" />
    <SolidColorBrush x:Key="PhraseColorMagenta" Color="#FF73FF" />
    <SolidColorBrush x:Key="PhraseColorPurple" Color="#AF60FF" />
    <SolidColorBrush x:Key="PhraseColorGreen" Color="#41C028" />
    <SolidColorBrush x:Key="PhraseColorPink" Color="#F67E91" />
    <SolidColorBrush x:Key="PhraseColorTeal" Color="#00A8A8" />
    <SolidColorBrush x:Key="PhraseColorTan" Color="#CB9563" />
    <SolidColorBrush x:Key="PhraseColorGray" Color="#5C6772" />

    <!-- ============================================================
         3. TYPOGRAPHY（Segoe UI Variable，中文回落微软雅黑）
         字号、行高对齐闪语原型 text-xs/sm/base/lg/xl（紧凑高密度）。
         ============================================================ -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei, PingFang SC, sans-serif</FontFamily>

    <!-- 页面标题 text-xl 20px -->
    <Style x:Key="TextH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <!-- 二级标题 text-lg 17px（模态/弹窗/分组标题） -->
    <Style x:Key="TextH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!-- Launcher 卡片主标题 17px -->
    <Style x:Key="TextLauncherTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- 话术行标题 15px / 500 weight（对齐 design-system.md text-base 15px） -->
    <Style x:Key="TextListTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 话术行/列表正文 15px（对齐 design-system.md text-base 15px） -->
    <Style x:Key="TextListBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 通用正文 text-sm 13px（Wrap） -->
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!-- text-xs 12px 次级说明 -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- 元数据 12px -->
    <Style x:Key="TextMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- eyebrow 11px 极小标签 -->
    <Style x:Key="TextEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- 等宽（序号列） -->
    <FontFamily x:Key="UiMonoFontFamily">Cascadia Mono, Consolas, Segoe UI Mono, monospace</FontFamily>
    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiMonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- ============================================================
         4. SPACING（4 / 8 / 12 / 16 / 24 栅格）
         ============================================================ -->
    <Thickness x:Key="SpaceXxs">4,4,4,4</Thickness>
    <Thickness x:Key="SpaceXs">8,8,8,8</Thickness>
    <Thickness x:Key="SpaceSm">12,12,12,12</Thickness>
    <Thickness x:Key="SpaceMd">16,16,16,16</Thickness>
    <Thickness x:Key="SpaceLg">24,24,24,24</Thickness>
    <Thickness x:Key="SpaceStackXs">0,4,0,0</Thickness>
    <Thickness x:Key="SpaceStackSm">0,8,0,0</Thickness>
    <Thickness x:Key="SpaceStackMd">0,12,0,0</Thickness>
    <Thickness x:Key="SpaceStackLg">0,16,0,0</Thickness>

    <!-- ============================================================
         5. RADIUS（小圆角，克制，≤16px）
         对齐闪语原型 radius-sm/md/lg（4 / 6 / 8）。
         ============================================================ -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusPopup">8</CornerRadius>
    <CornerRadius x:Key="RadiusLauncher">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>

    <!-- ============================================================
         6. CONTROL HEIGHTS（紧凑密度，对齐闪语原型 row-32/sub-28/btn-34/search-36）
         ============================================================ -->
    <sys:Double x:Key="ButtonHeight">34</sys:Double>
    <sys:Double x:Key="SearchBoxHeight">36</sys:Double>
    <sys:Double x:Key="CategoryItemHeight">30</sys:Double>
    <sys:Double x:Key="SettingsRowHeight">67</sys:Double>
    <sys:Double x:Key="ToggleWidth">38</sys:Double>
    <sys:Double x:Key="ToggleHeight">22</sys:Double>
    <sys:Double x:Key="LauncherCardMaxHeight">520</sys:Double>
    <sys:Double x:Key="LauncherCardMinWidth">680</sys:Double>
    <sys:Double x:Key="PhraseRowMinHeight">32</sys:Double>
    <sys:Double x:Key="SubHeaderHeight">34</sys:Double>
    <sys:Double x:Key="NavItemHeight">40</sys:Double>
    <sys:Double x:Key="AppFooterHeight">48</sys:Double>
    <sys:Double x:Key="ChipCountHeight">16</sys:Double>

</ResourceDictionary>

