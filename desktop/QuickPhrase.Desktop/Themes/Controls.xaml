<!--
  QuickPhrase 控件聚合入口。
  基础文字和原生控件 Style 先加载，复合组件外壳最后加载；页面只消费统一 Style/组件。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../DesignSystem/Styles/Text.xaml" />
        <ResourceDictionary Source="../DesignSystem/Styles/Buttons.xaml" />
        <ResourceDictionary Source="../DesignSystem/Styles/Inputs.xaml" />
        <ResourceDictionary Source="../DesignSystem/Styles/SelectionControls.xaml" />
        <ResourceDictionary Source="../DesignSystem/Styles/Lists.xaml" />
        <ResourceDictionary Source="../DesignSystem/Styles/Surfaces.xaml" />
        <ResourceDictionary Source="../DesignSystem/Styles/Dialogs.xaml" />
        <ResourceDictionary Source="../DesignSystem/Components/Components.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
