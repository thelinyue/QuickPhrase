<!--
  QuickPhrase 控件样式 — Windows Native Productivity
  依赖 Themes/QuickPhraseTheme.xaml（颜色/笔刷/排版/间距/圆角/控件高度）。
  由 App.xaml 的 MergedDictionaries 在主题之后加载，确保资源可被解析。
  设计原则：克制密度、小圆角、品牌蓝仅用于选中/聚焦/主操作；无强阴影、无大卡片套卡片。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 水平翻转（用于让发送图标箭头朝左） -->
    <ScaleTransform x:Key="HorizontalFlip" ScaleX="-1" />
    <!--
        左下角品牌图标与窗口、任务栏和托盘统一使用同一份内嵌 ICO 资源。
        资源来自 assets/quickphrase.ico，并通过 WPF Resource 映射到程序集，
        不依赖用户机器上的外部 Downloads 路径；CacheOption=OnLoad 也能避免
        XAML 解析完成后仍持有外部文件句柄。
    -->
    <BitmapImage x:Key="QuickPhraseBrandIcon"
                  UriSource="pack://application:,,,/QuickPhrase;component/Assets/quickphrase.ico"
                  CacheOption="OnLoad" />
    <!-- ====================== BUTTON ====================== -->
    <!-- 基础模板：hover/pressed 用黑色叠加层统一处理，任意背景色都适用 -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <Grid>
                            <Border x:Name="Overlay" Background="#000000" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSmall}" />
                            <Border x:Name="FocusRing" BorderBrush="{StaticResource FocusBrush}"
                                    BorderThickness="2" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSmall}" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnBrandPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- 方形图标按钮：32×32 圆角，透明底，hover 冰蓝底 + 品牌蓝图标（对齐 design-system.md 5.9 设置图标按钮） -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}">
                        <Grid>
                            <Border x:Name="Overlay" Background="#000000" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSmall}" />
                            <Border x:Name="FocusRing" BorderBrush="{StaticResource FocusBrush}"
                                    BorderThickness="2" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSmall}" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== TEXTBOX ====================== -->
    <Style x:Key="BaseTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="CaretBrush" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <Grid>
                            <!--
                                普通 TextBox 不预留图标列；文本起点只由 Padding 决定。
                                通过 TemplateBinding 同时支持单行默认间距和多行正文的 Padding="12,10"，
                                并保留 TextBox 的内容对齐与滚动属性，避免模板吞掉页面配置。
                            -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Stretch"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                            <Border x:Name="FocusRing" BorderBrush="{StaticResource FocusBrush}"
                                    BorderThickness="2" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        普通 TextBox 的隐式入口：引导窗口等未显式指定 Style 的输入框也必须使用同一套
        无图标模板，避免回退到 WPF 默认模板后重新出现不一致的文本起点。
    -->
    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}" />

    <!--
        搜索框是带图标输入控件的独立模板：只有这里为图标列保留固定空间，
        不把 28px 的前置偏移泄漏给普通 TextBox。
    -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
        <Setter Property="Height" Value="{StaticResource SearchBoxHeight}" />
        <!-- 输入间距只由 PART_ContentHost 的 Margin 提供，避免 Padding 与 Margin 叠加造成光标偏移。 -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}">
                        <Grid>
                            <!-- 左侧放大镜 16×16 -->
                            <Path Data="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                                  Fill="{StaticResource TextTertiaryBrush}"
                                  Stretch="Uniform" Width="16" Height="16"
                                  HorizontalAlignment="Left" Margin="12,0,0,0"
                                  VerticalAlignment="Center" IsHitTestVisible="False" />
                            <!--
                                不再依赖 ScrollViewer 的默认内容边界：明确固定输入起点，
                                避免 Padding、占位文本或图标覆盖层叠加造成光标偏移。
                            -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="28,0,16,0"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <Border x:Name="FocusRing" BorderBrush="{StaticResource BrandPrimaryBrush}"
                                    BorderThickness="2" Opacity="0"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== TOGGLE（用 CheckBox 样式化为 Windows 开关，避免依赖 ToggleSwitch 控件可用性） ====================== -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track"
                                Width="40" Height="22"
                                CornerRadius="11"
                                Background="{StaticResource SeparatorBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0"
                                     VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== NAVIGATION ITEM (ListBoxItem) ====================== -->
    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{StaticResource NavItemHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <Grid>
                            <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource BrandPrimaryBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== PHRASE ROW (ListViewItem) ====================== -->
    <!-- 紧凑 32px 行高；左 3px 主色竖条选中态；选中时序号+标题转 primary。 -->
    <Style x:Key="PhraseRowItem" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource PhraseRowMinHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- 左 3px 主色强调条：默认隐藏，选中显示 -->
                            <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource BrandPrimaryBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== TAG / SHORTCUT BADGE（定义在 PhraseRowTemplate 之前，避免同文件前向引用） ====================== -->
    <Style x:Key="TagPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandIceLightBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 话术行内容模板（与 LibraryView 同构）：序号·发送共享(40) + 标题(160) + 内容(*) 三列。
         序号列同时作为发送按钮占位：默认显示序号，行 hover 时隐藏序号、显现发送按钮。 -->
    <DataTemplate x:Key="PhraseRowTemplate">
        <ContentControl>
            <ContentControl.Template>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="RowRoot" Height="{StaticResource PhraseRowMinHeight}">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="发送到输入区" InputGestureText="双击"
                                          Command="{Binding Owner.InsertCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="直接发送"
                                          Command="{Binding Owner.InsertSendCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="复制内容到剪贴板"
                                          Command="{Binding Owner.CopyCommand}" CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="新增话术" Command="{Binding Owner.NewCommand}" />
                                <MenuItem Header="插入一条话术"
                                          Command="{Binding Owner.InsertCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="编辑" Command="{Binding Owner.EditCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="排序" IsEnabled="False" />
                                <MenuItem Header="移动到其它分类" Command="{Binding Owner.MoveCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="复制到其它分类" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="删除" Command="{Binding Owner.DeleteCommand}" CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="如何批量操作？" IsEnabled="False" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBlock x:Name="IndexText" Style="{StaticResource TextMono}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                       Text="{Binding IndexInCategory, StringFormat='{}{0}'}" />
                            <Button x:Name="SendBtn" Style="{StaticResource SendRowButton}"
                                    Opacity="0" IsHitTestVisible="False"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    ToolTip="直接发送"
                                    Command="{Binding Owner.InsertSendCommand}" CommandParameter="{Binding}" />
                        </Grid>
                        <TextBlock Grid.Column="1" Style="{StaticResource TextListTitle}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Title}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TextListBody}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Content}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                            <Setter TargetName="IndexText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SendBtn" Property="Opacity" Value="1" />
                            <Setter TargetName="SendBtn" Property="IsHitTestVisible" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ContentControl.Template>
        </ContentControl>
    </DataTemplate>

    <!-- ====================== SETTINGS KEYCAP ====================== -->
    <!-- 快捷键展示使用低噪音 Surface，不承担输入或保存职责。 -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================== COMBOBOX FIELD（编辑/设置弹窗的字段下拉；与 BaseTextBox 视觉一致） ====================== -->
    <Style x:Key="ComboBoxFieldStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ====================== CONTEXT MENU ======================
         注：WPF MenuItem 原生实现 UIA "menuitem" 控件模式，且支持键盘 Escape 关闭，
         已天然满足 design-system.md 7 中 "菜单项带 role=menuitem" 的无障碍要求。 -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusPopup}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" />
                            <TextBlock x:Name="InputGesture" Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Style="{StaticResource TextMeta}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
    </Style>

    <!-- ====================== DIALOG WINDOW ====================== -->
    <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <!-- 注意：WindowStartupLocation 是 CLR 属性而非 DependencyProperty，
             不能放进 Setter（运行时 Setter.Property 会解析为 null 而崩溃）。
             由各对话框在根 <Window> 上以直接属性 WindowStartupLocation="CenterOwner" 设置。 -->
    </Style>

    <!-- ====================== CATEGORY CHIP（一级分类胶囊） ====================== -->
    <!-- 基于 ToggleButton 实现选中态。基于 BaseButton 模板保留 hover overlay。 -->
    <Style x:Key="CategoryChip" TargetType="ToggleButton">
        <Setter Property="Height" Value="{StaticResource CategoryItemHeight}" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <!-- 一级分类颜色固定为主题色（引用主题变量，不写死色值）：默认主题主色整块铺满；
             字体恒为白色，不随选中态变化；选中态仅背景加深为 BrandPrimaryPressedBrush 以突出 -->
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <Grid>
                            <Border x:Name="Overlay" Background="#000000" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSmall}" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.04" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BrandPrimaryPressedBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandPrimaryPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 新建一级分类"+"按钮：30×30 虚线圆角（对齐 design-system.md 5.8） -->
    <Style x:Key="CreateCategoryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 用 Rectangle + StrokeDashArray 实现虚线边框（Border 不支持虚线） -->
                    <Grid>
                        <Rectangle x:Name="Root"
                                   Fill="{TemplateBinding Background}"
                                   Stroke="{TemplateBinding BorderBrush}"
                                   StrokeThickness="{TemplateBinding BorderThickness}"
                                   StrokeDashArray="3 2"
                                   RadiusX="6" RadiusY="6" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="+" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Stroke" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter TargetName="Root" Property="Fill" Value="{StaticResource HoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 数量徽标：用于 Chip 内部与 Sub Header 右侧 -->
    <Style x:Key="ChipCount" TargetType="Border">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="ChipCountText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{StaticResource UiMonoFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================== SUB HEADER（二级分类标题条） ====================== -->
    <!-- 左侧仅显示展开/收起箭头（内容模板内，随 IsExpanded 旋转：展开朝下 / 收起朝右）；
         背景固定为淡蓝色（主题变量 SubHeaderBlueBrush），展开/未展开视觉样式一致（不加深）；
         height = PhraseRowMinHeight，与话术行等高，保证列表行垂直间距统一紧凑。 -->
    <Style x:Key="SubHeaderButton" TargetType="ToggleButton">
        <Setter Property="Height" Value="{StaticResource PhraseRowMinHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 标题文字保持默认样式（TextPrimaryBrush），其下方话术行亦为默认文字样式 -->
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SubHeaderBlueBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource SeparatorBrush}">
                        <ContentPresenter Margin="8,0,16,0" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- chevron 折叠箭头 Path：默认向下，旋转由 BoolToArrowRotationConverter 控制 -->
    <Style x:Key="SubHeaderChevron" TargetType="Path">
        <Setter Property="Data" Value="M6 9l6 6 6-6" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== MENUITEM DANGER（危险操作样式） ====================== -->
    <!-- 通过附加依赖属性 QuickPhrase.Desktop.Controls.MenuItemProperties.IsDanger 启用 -->
    <Style x:Key="DangerMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" />
                            <TextBlock x:Name="InputGesture" Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Style="{StaticResource TextMeta}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource DangerColor}" Opacity="0.08" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== TOAST CONTAINER（轻提示容器） ====================== -->
    <!-- 底部居中、slate-900 底、白字、radius-lg(8)、shadow-lg。 -->
    <Style x:Key="ToastStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.10" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToastText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    </Style>

    <!-- ====================== PHRASE ROW SEND BUTTON（行左侧"直接发送"占位） ======================
         默认 Opacity=0（仅占位、不响应命中），行 hover 时由 PhraseRowTemplate 触发显现并可点击。 -->
    <Style x:Key="SendRowButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <Grid>
                            <!-- 纸飞机 / 发送 图标：水平翻转使箭头朝向左侧，符合"直接发送"操作预期 -->
                            <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                  Stretch="Uniform" Width="16" Height="16"
                                  Fill="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5"
                                  RenderTransform="{StaticResource HorizontalFlip}"
                                  IsHitTestVisible="False" />
                            <Border x:Name="Overlay" Background="#000000" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSmall}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== KBD（键盘徽标） ====================== -->
    <Style x:Key="KbdBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
