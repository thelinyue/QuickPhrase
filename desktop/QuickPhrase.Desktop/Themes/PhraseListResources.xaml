<!--
  正式 WPF 话术列表共享资源。
  这里只定义序号·标题·正文的显示结构和基础选中/悬停视觉；右键菜单、拖拽和发送命令由宿主注入。
  LibraryView 与 LauncherWindow 必须使用同一份模板，避免两套列表视觉继续漂移。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:QuickPhrase.Desktop"
                     xmlns:desktopControls="clr-namespace:QuickPhrase.Desktop.Controls">

    <!-- 话术行容器：选中态浅紫背景 + 左侧主色强调条，悬停只改变背景，不改变行高。 -->
    <Style x:Key="PhraseListItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource PhraseRowMinHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      共享行模板：三列固定为序号、标题、正文。
      序号绑定 IndexInCategory；Launcher 适配模型沿用同名属性，因此无需复制模板或暴露 CategoryId。
      发送按钮是可选的宿主动作槽：LibraryView 注入命令，Launcher 关闭该槽并只保留安全插入菜单。
    -->
    <DataTemplate x:Key="PhraseListRowTemplate">
        <ContentControl>
            <ContentControl.Template>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="RowRoot" Height="{StaticResource PhraseRowMinHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.TitleColumnWidth)}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock x:Name="IndexText" Style="{StaticResource TextMono}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                       Text="{Binding IndexInCategory}" />
                            <Button x:Name="SendBtn" Style="{StaticResource SendRowButton}"
                                    Opacity="0" IsHitTestVisible="False"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    ToolTip="直接发送"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.SendCommand)}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                        <desktopControls:OverflowTextBlock Grid.Column="1" Style="{StaticResource TextListTitle}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                   Text="{Binding Title}" />
                        <desktopControls:OverflowTextBlock Grid.Column="2" Style="{StaticResource TextListBody}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Content}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.ShowSendButton)}" Value="False">
                            <Setter TargetName="SendBtn" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=RowRoot}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.ShowSendButton)}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="IndexText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SendBtn" Property="Opacity" Value="1" />
                            <Setter TargetName="SendBtn" Property="IsHitTestVisible" Value="True" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ContentControl.Template>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>


