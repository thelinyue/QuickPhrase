<UserControl x:Class="QuickPhrase.Desktop.DesignSystem.Components.PhraseRichTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border x:Name="EditorBorder"
            Background="{DynamicResource Brush.Surface.Default}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="{StaticResource Thickness.Border.Default}"
            CornerRadius="{StaticResource Radius.Control}">
        <RichTextBox x:Name="EditorBox"
                     BorderThickness="{StaticResource Thickness.None}"
                     Background="Transparent"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     Padding="{StaticResource Thickness.Control.Input.Multiline}"
                     AcceptsTab="True"
                     IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="False"
                     AllowDrop="True"
                     AutomationProperties.Name="话术图文内容编辑区"
                     PreviewKeyDown="EditorBox_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="EditorBox_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="EditorBox_PreviewMouseMove"
                     DragOver="EditorBox_DragOver"
                     Drop="EditorBox_Drop"
                     TextChanged="EditorBox_TextChanged"
                     GotKeyboardFocus="EditorBox_GotKeyboardFocus"
                     LostKeyboardFocus="EditorBox_LostKeyboardFocus" />
    </Border>
</UserControl>
