<UserControl x:Class="QuickPhrase.Desktop.DesignSystem.Components.SettingItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickPhrase.Desktop.DesignSystem.Components"
             x:Name="Root"
             Style="{StaticResource Style.Component.SettingItem}">
    <Border Style="{StaticResource Style.Setting.Row}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="{StaticResource Thickness.Gap.Inline.LG}">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title, ElementName=Root}"
                               Style="{StaticResource Style.Text.Label}"
                               Margin="{StaticResource Thickness.Gap.Stack.XS}" />
                    <TextBlock Text="{Binding Description, ElementName=Root}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body.Small}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ContentPresenter Grid.Column="1"
                                  Content="{Binding ControlContent, ElementName=Root}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
            </Grid>

            <Rectangle Grid.Row="1"
                       Height="{Binding Top, Source={StaticResource Thickness.Border.Default}}"
                       Fill="{DynamicResource Brush.Border.Subtle}"
                       VerticalAlignment="Bottom">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDivider, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </Grid>
    </Border>
</UserControl>
