<UserControl x:Class="QuickPhrase.Desktop.DesignSystem.Components.PhraseResultItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Style="{StaticResource Style.Component.PhraseResultItem}">
    <Grid MinHeight="{StaticResource Size.Phrase.Row.Minimum}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="{StaticResource Thickness.Gap.Inline.MD}">
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource Style.Text.Body.Medium}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Title, ElementName=Root}" />
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Metadata, ElementName=Root}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Metadata, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Metadata, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <ContentPresenter Grid.Column="1"
                          Content="{Binding TrailingContent, ElementName=Root}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
    </Grid>
</UserControl>
