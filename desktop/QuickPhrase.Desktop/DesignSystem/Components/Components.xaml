<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:QuickPhrase.Desktop.DesignSystem.Components">
    <!-- 组件级 Style 只描述复合控件外壳；内部排版继续复用 Text、Input、Button 与 Surface 公共 Style。 -->
    <Style x:Key="Style.Component.SettingItem" TargetType="{x:Type components:SettingItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="Style.Component.SearchInput" TargetType="{x:Type components:SearchInput}">
        <Setter Property="Height" Value="{StaticResource Size.Input.Search}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="Style.Component.PhraseResultItem" TargetType="{x:Type components:PhraseResultItem}">
        <Setter Property="MinHeight" Value="{StaticResource Size.Phrase.Row.Minimum}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="Style.Component.CategoryTreeItem" TargetType="{x:Type components:CategoryTreeItem}">
        <Setter Property="MinHeight" Value="{StaticResource Size.Navigation.Item}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="Style.Component.ShortcutInput" TargetType="{x:Type components:ShortcutInput}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
    </Style>
</ResourceDictionary>
