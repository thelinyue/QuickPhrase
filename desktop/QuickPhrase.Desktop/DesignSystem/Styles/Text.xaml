        <Setter Property="FontSize" Value="{StaticResource Typography.Title.Small.FontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Title.Small.FontWeight}" />
        <Setter Property="LineHeight" Value="{StaticResource Typography.Title.Small.LineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

