<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Switch 使用 CheckBox 的原生选中语义。轨道和 Thumb 均位于单一模板内，
        不依赖动画或代码隐藏；键盘 Space、焦点和自动化语义继续由 CheckBox 提供。
    -->
    <Style x:Key="Style.Switch.Default" TargetType="CheckBox">
        <Setter Property="Width" Value="{StaticResource Size.Switch.Width}" />
        <Setter Property="Height" Value="{StaticResource Size.Switch.Height}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="{StaticResource Size.Switch.Width}"
                          Height="{StaticResource Size.Switch.Height}">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Large}" />
                        <Ellipse x:Name="Thumb"
                                 Width="{StaticResource Size.Switch.Thumb}"
                                 Height="{StaticResource Size.Switch.Thumb}"
                                 Margin="{StaticResource Thickness.Border.Default}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Surface.Default}" />
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.Border.Focus}"
                                BorderThickness="{StaticResource Thickness.Border.Default}"
                                CornerRadius="{StaticResource Radius.Large}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
