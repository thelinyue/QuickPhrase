<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dialog Style 只统一窗口表面、边框、排版和阴影；启动位置、尺寸和可调整策略仍由具体窗口声明，
        避免公共 Style 改变现有窗口生命周期和业务行为。
    -->
    <Style x:Key="Style.Dialog.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Shadow.Dialog}" />
    </Style>

    <!-- ContextMenu 使用原生 ItemsPresenter，不包装额外 ItemsControl，保留命令、手势文本和子菜单语义。 -->
    <Style x:Key="Style.Menu.Context" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.XS}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Medium.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Shadow.Popup}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Popup}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        通用 MenuItem 保留 WPF 原生 Role-aware 模板，避免破坏 SubmenuHeader、PART_Popup、
        ItemsPresenter、Checked 和子菜单箭头。这里只统一语义资源和轻量状态颜色。
    -->
    <Style x:Key="Style.Menu.Item" TargetType="MenuItem">
        <Setter Property="Padding" Value="{StaticResource Thickness.SM}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Medium.FontSize}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.Menu.Item.Danger" TargetType="MenuItem" BasedOn="{StaticResource Style.Menu.Item}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
    </Style>

    <Style x:Key="Style.Menu.Separator" TargetType="Separator">
        <Setter Property="Height" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.XS}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Default}" />
    </Style>
</ResourceDictionary>
