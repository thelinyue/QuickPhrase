<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        TextBox 模板不预留图标列。PART_ContentHost 的 Margin 直接承接 Padding，
        因此普通输入框和搜索输入框的光标均从同一语义内边距开始。
    -->
    <Style x:Key="Style.Input.Base" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource Size.Control.Default}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control.Input}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Surface.Selected}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Medium.FontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <Border x:Name="FocusRing"
                                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                                    BorderThickness="{StaticResource Thickness.Border.Default}"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="Validation.HasError" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}" />
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <!-- Disabled 始终覆盖 Hover/Focus/Error，禁用且校验失败时不显示错误焦点环。 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Input.Default" TargetType="TextBox" BasedOn="{StaticResource Style.Input.Base}" />
    <Style x:Key="Style.Input.Default.Compact" TargetType="TextBox" BasedOn="{StaticResource Style.Input.Base}">
        <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
    </Style>
    <Style x:Key="Style.Input.Search" TargetType="TextBox" BasedOn="{StaticResource Style.Input.Base}">
        <Setter Property="Height" Value="{StaticResource Size.Input.Search}" />
    </Style>

    <!-- PasswordBox 复用普通输入框的语义尺寸、边框和焦点环，但保留原生密码字符呈现。 -->
    <Style x:Key="Style.Input.Password" TargetType="PasswordBox">
        <Setter Property="Height" Value="{StaticResource Size.Control.Default}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control.Input}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Medium.FontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Brush.Border.Focus}" BorderThickness="{StaticResource Thickness.Border.Default}" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ComboBox 使用原生 PART_Popup 和 ItemsPresenter，保留键盘选择与容器虚拟化能力；
        视觉状态只修改语义 Brush，并转发 ItemTemplateSelector 以保留 DisplayMemberPath，不在页面复制下拉框模板。
    -->
    <Style x:Key="Style.Select.Default" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource Size.Control.Default}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control.Input}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Medium.FontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False" />
                        </Border>
                        <ToggleButton x:Name="DropDownToggle"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Path Width="{StaticResource Size.Select.DropDownArrow.Width}"
                                              Height="{StaticResource Size.Select.DropDownArrow.Height}"
                                              Margin="{StaticResource Thickness.Gap.Inline.SM}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource Brush.Text.Secondary}"
                                              IsHitTestVisible="False" />
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.Border.Focus}"
                                BorderThickness="{StaticResource Thickness.Border.Default}"
                                CornerRadius="{StaticResource Radius.Control}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <!--
                                外层容器统一约束完整 Popup 高度，使 4px 放置间距、Surface Padding 与 Border
                                全部计入 MaxDropDownHeight，避免独立 Popup 根视觉超出调用方配置。
                            -->
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="{StaticResource Thickness.Gap.Stack.XS}"
                                        Padding="{StaticResource Thickness.Popup}"
                                        Background="{DynamicResource Brush.Surface.Elevated}"
                                        BorderBrush="{DynamicResource Brush.Border.Default}"
                                        BorderThickness="{StaticResource Thickness.Border.Default}"
                                        CornerRadius="{StaticResource Radius.Popup}"
                                        Effect="{DynamicResource Effect.Shadow.Popup}">
                                    <ScrollViewer CanContentScroll="True"
                                                  KeyboardNavigation.DirectionalNavigation="Contained">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsDropDownOpen" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="Validation.HasError" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}" />
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <!-- Disabled 直接覆盖模板部件，确保 Disabled + Validation 始终呈现禁用视觉。 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="DropDownToggle" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
