<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 默认 Card 只使用 1px 边框，不使用阴影，避免内容区形成后台管理系统式卡片堆叠。 -->
    <Style x:Key="Style.Card.Default" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Style.Card.Elevated" TargetType="Border" BasedOn="{StaticResource Style.Card.Default}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Shadow.Elevated}" />
    </Style>

    <Style x:Key="Style.Popup.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Popup}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Popup}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Shadow.Popup}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Style.Setting.Group" TargetType="Border" BasedOn="{StaticResource Style.Card.Default}">
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
    </Style>

    <Style x:Key="Style.Setting.Row" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Settings.Row}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.State.Hover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.Keycap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Window}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XS}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.XS}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Style.Toast.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Popup}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
