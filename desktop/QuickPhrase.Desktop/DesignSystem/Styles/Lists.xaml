<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:QuickPhrase.Desktop"
                    xmlns:desktopControls="clr-namespace:QuickPhrase.Desktop.Controls">
    <!--
        DataTemplate 在运行时延迟实例化，StaticResource 只会沿模板所属字典的词法资源链解析。
        显式合并文字与按钮依赖，避免拆分字典后真实列表项首次生成时找不到共享 Style。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Text.xaml" />
        <ResourceDictionary Source="Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!--
        ListBoxItem 模板只包装当前容器内容，不创建 ItemsControl，
        从而保留宿主 ListBox/ListView 的容器回收与虚拟化策略。
    -->
    <Style x:Key="Style.ListItem.Navigation" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource Size.Navigation.Item}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control.Button.Compact}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.ListItem.Phrase" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource Size.Phrase.Row.Minimum}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Gap.Inline.SM}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        话术列表只保留业务专属的三列行结构和左侧选中指示条。
        容器基础状态继承 Style.ListItem.Phrase，颜色、尺寸与排版全部消费全局 Design System。
    -->
    <Style x:Key="Style.ListItem.Phrase.Library"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource Style.ListItem.Phrase}">
        <Setter Property="MinHeight" Value="{StaticResource Size.Phrase.Row.Minimum}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.None}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Bottom}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- 3px 是业务选中指示条的几何宽度，不属于通用控件尺寸。 -->
                            <Rectangle x:Name="AccentBar"
                                       Width="{StaticResource Size.List.SelectionIndicator.Width}"
                                       HorizontalAlignment="Left"
                                       Fill="{DynamicResource Brush.Selection.Indicator}"
                                       Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      共享行模板固定为序号、标题、正文三列，不新增 ItemsControl，继续复用宿主 ListBox 的回收虚拟化。
      Launcher 适配模型沿用 IndexInCategory/Title/Content；可选发送动作仍由附加属性注入。
    -->
    <DataTemplate x:Key="Template.Phrase.Row">
        <ContentControl>
            <ContentControl.Template>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="RowRoot" MinHeight="{StaticResource Size.Phrase.Row.Minimum}">
                        <Grid.ColumnDefinitions>
                            <!-- 序号/发送槽与 32px 紧凑行保持一致；标题列宽仍由宿主拖拽策略提供。 -->
                            <ColumnDefinition Width="{StaticResource Size.Phrase.IndexColumn.GridLength}" />
                            <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.TitleColumnWidth)}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock x:Name="IndexText"
                                       Style="{StaticResource Style.Text.Mono}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource Thickness.Gap.Inline.SM}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                       Text="{Binding IndexInCategory}" />
                            <Button x:Name="SendBtn"
                                    Style="{StaticResource Style.Button.Icon}"
                                    Content="➤"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    ToolTip="直接发送"
                                    AutomationProperties.Name="直接发送"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.SendCommand)}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                        <Grid Grid.Column="1" Margin="{StaticResource Thickness.Gap.Inline.MD}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Brush.Accent.Soft}"
                                    CornerRadius="{StaticResource Radius.XS}"
                                    Padding="{StaticResource Thickness.Gap.Inline.XS}"
                                    Margin="{StaticResource Thickness.Gap.Inline.XS}"
                                    Visibility="{Binding IsEnterprise, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="企业" Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Accent.Primary.Pressed}" />
                            </Border>
                            <desktopControls:OverflowTextBlock Grid.Column="1"
                                                               Style="{StaticResource Style.Text.Label}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                                               Text="{Binding Title}" />
                        </Grid>
                        <desktopControls:OverflowTextBlock Grid.Column="2"
                                                           Style="{StaticResource Style.Text.Body.Medium}"
                                                           VerticalAlignment="Center"
                                                           Margin="{StaticResource Thickness.Gap.Inline.XS}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Content}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.ShowSendButton)}" Value="False">
                            <Setter TargetName="SendBtn" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=RowRoot}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=(local:PhraseListActions.ShowSendButton)}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="IndexText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SendBtn" Property="Opacity" Value="1" />
                            <Setter TargetName="SendBtn" Property="IsHitTestVisible" Value="True" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ContentControl.Template>
        </ContentControl>
    </DataTemplate>
    <!-- 历史搜索项作为共享控件的标准轻量列表项，页面不得复制该选择与焦点反馈模板。 -->
    <Style x:Key="Style.ListItem.SearchHistory" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource Thickness.None}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.Gap.Inline.SM}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card"
                            Padding="{StaticResource Thickness.XS}"
                            Background="{DynamicResource Brush.Background.Default}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="{StaticResource Thickness.Border.Default}"
                            CornerRadius="{StaticResource Radius.XS}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
