<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 4px 基础网格。标准视觉间距使用 Thickness，避免页面散落裸 Double。 -->
    <Thickness x:Key="Thickness.None">0</Thickness>
    <Thickness x:Key="Thickness.XS">4</Thickness>
    <Thickness x:Key="Thickness.SM">8</Thickness>
    <Thickness x:Key="Thickness.MD">12</Thickness>
    <Thickness x:Key="Thickness.LG">16</Thickness>
    <Thickness x:Key="Thickness.XL">20</Thickness>
    <Thickness x:Key="Thickness.XXL">24</Thickness>
    <Thickness x:Key="Thickness.XXXL">32</Thickness>
    <Thickness x:Key="Thickness.4XL">40</Thickness>
    <Thickness x:Key="Thickness.5XL">48</Thickness>

    <!-- 语义间距统一在此确定；控件高度由 Size Token 控制，因此按钮和输入框仅保留水平内边距。 -->
    <Thickness x:Key="Thickness.Border.Default">1</Thickness>
    <Thickness x:Key="Thickness.Border.Top">0,1,0,0</Thickness>
    <Thickness x:Key="Thickness.Border.Bottom">0,0,0,1</Thickness>
    <Thickness x:Key="Thickness.Border.Right">0,0,1,0</Thickness>
    <Thickness x:Key="Thickness.Page">24</Thickness>
    <Thickness x:Key="Thickness.Section">0,0,0,24</Thickness>
    <Thickness x:Key="Thickness.Card">16</Thickness>
    <Thickness x:Key="Thickness.Dialog">24</Thickness>
    <Thickness x:Key="Thickness.Popup">12</Thickness>
    <Thickness x:Key="Thickness.Control.Button.Compact">12,0</Thickness>
    <Thickness x:Key="Thickness.Control.Button.Default">16,0</Thickness>
    <Thickness x:Key="Thickness.Control.Input">12,0</Thickness>
    <Thickness x:Key="Thickness.Control.Input.Multiline">12,10</Thickness>
    <Thickness x:Key="Thickness.Window.ResizeBorder">6</Thickness>

    <!-- Inline Token 作为右侧间距，Stack Token 作为下侧间距，便于列表和表单保持一致节奏。 -->
    <Thickness x:Key="Thickness.Gap.Inline.XS">0,0,4,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Inline.SM">0,0,8,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Inline.MD">0,0,12,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Inline.LG">0,0,16,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Inline.Before.MD">12,0,0,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Inline.Before.LG">16,0,0,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.XS">0,0,0,4</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.SM">0,0,0,8</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.MD">0,0,0,12</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.LG">0,0,0,16</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.Before.XS">0,4,0,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.Before.SM">0,8,0,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.Before.MD">0,12,0,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.Before.LG">0,16,0,0</Thickness>
    <Thickness x:Key="Thickness.Gap.Stack.Before.XL">0,20,0,0</Thickness>

    <!-- Shell 与页面复合区域只保留少量语义组合，避免把结构关系重新散落到页面。 -->
    <Thickness x:Key="Thickness.Launcher.Section">0,12,0,8</Thickness>
    <Thickness x:Key="Thickness.Launcher.Preview">0,4,0,12</Thickness>
    <Thickness x:Key="Thickness.Launcher.FooterHint">0,0,16,0</Thickness>
    <Thickness x:Key="Thickness.Onboarding.Content">0,20,0,16</Thickness>
    <Thickness x:Key="Thickness.Onboarding.IntroDescription">0,12,0,20</Thickness>
    <Thickness x:Key="Thickness.Onboarding.CopyBlock">0,12,0,16</Thickness>
    <Thickness x:Key="Thickness.Library.Header">20,8,20,8</Thickness>
    <Thickness x:Key="Thickness.Library.Toolbar">16,8,16,8</Thickness>
    <Thickness x:Key="Thickness.Library.Footer">20,0,20,0</Thickness>

    <!-- 对话框保持统一的 16px 分区节奏，列表选项按 4px 网格收敛。 -->
    <Thickness x:Key="Thickness.Dialog.Footer">0,16,0,0</Thickness>
    <Thickness x:Key="Thickness.Dialog.SectionLabel">0,16,0,8</Thickness>
    <Thickness x:Key="Thickness.Dialog.Footer.Padding">0,16,0,0</Thickness>
    <Thickness x:Key="Thickness.Dialog.Option">0,4,0,4</Thickness>
    <Thickness x:Key="Thickness.Dialog.InlineAction">16,0,8,0</Thickness>
    <Thickness x:Key="Thickness.Dialog.Summary">0,8,0,12</Thickness>
    <Thickness x:Key="Thickness.Dialog.SummaryValue">4,0,16,0</Thickness>
    <Thickness x:Key="Thickness.Dialog.SummaryValue.Last">4,0,0,0</Thickness>
    <Thickness x:Key="Thickness.Dialog.Label">0,0,0,8</Thickness>

    <!-- 保留当前设置窗口已验证的 40/32 页面边距和 16/8 行内节奏。 -->
    <Thickness x:Key="Thickness.Settings.Page">40,32,40,32</Thickness>
    <Thickness x:Key="Thickness.Settings.Row">16,8,16,8</Thickness>
    <Thickness x:Key="Thickness.Settings.Navigation">8,16,8,16</Thickness>
    <Thickness x:Key="Thickness.Settings.HeaderDescription">0,4,0,24</Thickness>
    <Thickness x:Key="Thickness.Settings.SectionTitle">0,0,0,8</Thickness>
    <Thickness x:Key="Thickness.Settings.Footer">24,8,24,10</Thickness>
    <Thickness x:Key="Thickness.Settings.DataStatus">16,12,16,0</Thickness>
    <Thickness x:Key="Thickness.Settings.DataError">16,4,16,16</Thickness>
</ResourceDictionary>
