<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        全局排版 Token 只描述字体族、字号、字重和行高。
        TextBlock Style 将在 Styles/Text.xaml 中组合这些原子资源；V1 不实现 LetterSpacing。
    -->
    <FontFamily x:Key="Typography.FontFamily.UI">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Typography.FontFamily.Mono">Cascadia Mono, Consolas, Segoe UI Mono</FontFamily>

    <sys:Double x:Key="Typography.Title.Large.FontSize">18</sys:Double>
    <FontWeight x:Key="Typography.Title.Large.FontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="Typography.Title.Large.LineHeight">24</sys:Double>

    <sys:Double x:Key="Typography.Title.Medium.FontSize">16</sys:Double>
    <FontWeight x:Key="Typography.Title.Medium.FontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="Typography.Title.Medium.LineHeight">22</sys:Double>

    <sys:Double x:Key="Typography.Title.Small.FontSize">14</sys:Double>
    <FontWeight x:Key="Typography.Title.Small.FontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="Typography.Title.Small.LineHeight">20</sys:Double>

    <sys:Double x:Key="Typography.Body.Large.FontSize">14</sys:Double>
    <FontWeight x:Key="Typography.Body.Large.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="Typography.Body.Large.LineHeight">22</sys:Double>

    <sys:Double x:Key="Typography.Body.Medium.FontSize">13</sys:Double>
    <FontWeight x:Key="Typography.Body.Medium.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="Typography.Body.Medium.LineHeight">20</sys:Double>

    <sys:Double x:Key="Typography.Body.Small.FontSize">12</sys:Double>
    <FontWeight x:Key="Typography.Body.Small.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="Typography.Body.Small.LineHeight">18</sys:Double>

    <sys:Double x:Key="Typography.Caption.FontSize">12</sys:Double>
    <FontWeight x:Key="Typography.Caption.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="Typography.Caption.LineHeight">16</sys:Double>

    <sys:Double x:Key="Typography.Label.FontSize">13</sys:Double>
    <FontWeight x:Key="Typography.Label.FontWeight">Medium</FontWeight>
    <sys:Double x:Key="Typography.Label.LineHeight">18</sys:Double>

    <sys:Double x:Key="Typography.Mono.FontSize">13</sys:Double>
    <FontWeight x:Key="Typography.Mono.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="Typography.Mono.LineHeight">18</sys:Double>
</ResourceDictionary>
