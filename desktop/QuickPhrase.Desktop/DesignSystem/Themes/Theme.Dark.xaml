<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme 与 Light Theme 保持完全一致的语义 Key，仅调整对比度和层级。 -->
    <Color x:Key="Color.Background.Default">#0F172A</Color>
    <Color x:Key="Color.Background.Secondary">#111C2E</Color>
    <Color x:Key="Color.Surface.Default">#172033</Color>
    <Color x:Key="Color.Surface.Hover">#1E293B</Color>
    <Color x:Key="Color.Surface.Selected">#1E3A5F</Color>
    <Color x:Key="Color.Surface.Elevated">#1E293B</Color>
    <Color x:Key="Color.Accent.Primary">#60A5FA</Color>
    <Color x:Key="Color.Accent.Primary.Hover">#93C5FD</Color>
    <Color x:Key="Color.Accent.Primary.Pressed">#3B82F6</Color>
    <Color x:Key="Color.Accent.Soft">#1E3A5F</Color>
    <Color x:Key="Color.Accent.Gold">#FBBF24</Color>
    <Color x:Key="Color.Accent.Gold.Strong">#F59E0B</Color>
    <Color x:Key="Color.Text.Primary">#F8FAFC</Color>
    <Color x:Key="Color.Text.Secondary">#CBD5E1</Color>
    <Color x:Key="Color.Text.Disabled">#64748B</Color>
    <Color x:Key="Color.Text.OnAccent">#0F172A</Color>
    <Color x:Key="Color.Border.Default">#334155</Color>
    <Color x:Key="Color.Border.Strong">#475569</Color>
    <Color x:Key="Color.Border.Focus">#4A90FF</Color>
    <Color x:Key="Color.Selection.Indicator">#4A90FF</Color>
    <Color x:Key="Color.Status.Success">#58C78F</Color>
    <Color x:Key="Color.Status.Warning">#F3B85B</Color>
    <Color x:Key="Color.Status.Error">#F07878</Color>
    <Color x:Key="Color.Overlay">#000000</Color>
    <Color x:Key="Color.Shadow.Default">#0B111A</Color>
</ResourceDictionary>
