<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme 只定义语义颜色；组件不得直接引用 Hex 或品牌原色。 -->
    <Color x:Key="Color.Background.Default">#F8FAFC</Color>
    <Color x:Key="Color.Background.Secondary">#F1F5F9</Color>
    <Color x:Key="Color.Surface.Default">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Hover">#F8FAFC</Color>
    <Color x:Key="Color.Surface.Selected">#EFF6FF</Color>
    <Color x:Key="Color.Surface.Elevated">#FFFFFF</Color>
    <Color x:Key="Color.Accent.Primary">#2563EB</Color>
    <Color x:Key="Color.Accent.Primary.Hover">#1D4ED8</Color>
    <Color x:Key="Color.Accent.Primary.Pressed">#1E40AF</Color>
    <Color x:Key="Color.Accent.Soft">#DBEAFE</Color>
    <Color x:Key="Color.Accent.Gold">#FBBF24</Color>
    <Color x:Key="Color.Accent.Gold.Strong">#F59E0B</Color>
    <Color x:Key="Color.Text.Primary">#1E293B</Color>
    <Color x:Key="Color.Text.Secondary">#64748B</Color>
    <Color x:Key="Color.Text.Disabled">#94A3B8</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Border.Default">#E2E8F0</Color>
    <Color x:Key="Color.Border.Strong">#CBD5E1</Color>
    <Color x:Key="Color.Border.Focus">#4A90FF</Color>
    <Color x:Key="Color.Selection.Indicator">#4A90FF</Color>
    <Color x:Key="Color.Status.Success">#168A55</Color>
    <Color x:Key="Color.Status.Warning">#C26A05</Color>
    <Color x:Key="Color.Status.Error">#D13C3C</Color>
    <Color x:Key="Color.Overlay">#000000</Color>
    <Color x:Key="Color.Shadow.Default">#94A3B8</Color>
</ResourceDictionary>
