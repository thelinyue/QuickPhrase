<!-- 设置窗口：独立承载设置视图，窗口尺寸、标题栏和主题视觉全部消费全局 Design Token。 -->
<Window x:Class="QuickPhrase.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickPhrase.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="闪语 · 设置"
        Icon="pack://application:,,,/QuickPhrase;component/Assets/quickphrase.ico"
        Width="{StaticResource Size.SettingsWindow.Width}"
        Height="{StaticResource Size.SettingsWindow.Height}"
        MinWidth="{StaticResource Size.SettingsWindow.MinimumWidth}"
        MinHeight="{StaticResource Size.SettingsWindow.MinimumHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background.Window}"
        FontFamily="{StaticResource Typography.FontFamily.UI}"
        Loaded="SettingsWindow_Loaded"
        Closing="SettingsWindow_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource Size.TitleBar.Height}"
                            ResizeBorderThickness="{StaticResource Thickness.Window.ResizeBorder}"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Size.TitleBar.GridLength}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:TitleBar Grid.Row="0" PageTitle="设置" />
        <ContentControl x:Name="ContentRegion"
                        Grid.Row="1"
                        Background="{DynamicResource Brush.Surface.Primary}" />
    </Grid>
</Window>
