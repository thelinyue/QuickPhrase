<Window x:Class="QuickPhrase.Desktop.BatchPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分批预览"
        Width="{StaticResource Size.BatchPreview.Width}"
        Height="{StaticResource Size.BatchPreview.Height}"
        MinWidth="{StaticResource Size.BatchPreview.MinimumWidth}"
        MaxHeight="{StaticResource Size.BatchPreview.MaximumHeight}"
        Style="{StaticResource Style.Dialog.Window}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="{StaticResource Thickness.XL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="分批预览" Style="{StaticResource Style.Text.Title.Large}" />
            <TextBlock x:Name="SummaryText"
                       Style="{StaticResource Style.Text.Body.Small}"
                       Margin="{StaticResource Thickness.Gap.Stack.Before.SM}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>
        <Border Grid.Row="1"
                Margin="{StaticResource Thickness.BatchPreview.Capability}"
                Padding="{StaticResource Thickness.SM}"
                Background="{DynamicResource Brush.Surface.Subtle}"
                BorderBrush="{DynamicResource Brush.Status.Warning}"
                BorderThickness="{StaticResource Thickness.Border.Default}"
                CornerRadius="{StaticResource Radius.Control}">
            <TextBlock x:Name="CapabilityText" Style="{StaticResource Style.Text.Body.Small}" TextWrapping="Wrap" />
        </Border>
        <ListBox x:Name="SegmentsList"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="{StaticResource Thickness.None}"
                 AutomationProperties.Name="分批发送顺序"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="{StaticResource Thickness.Border.Default}"
                            CornerRadius="{StaticResource Radius.Card}"
                            Margin="{StaticResource Thickness.Gap.Stack.SM}"
                            Padding="{StaticResource Thickness.SM}"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Size.BatchPreview.IndexColumn}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index}" Style="{StaticResource Style.Text.Label}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Style.Text.Label}" />
                                <TextBlock Text="{Binding Text}"
                                           Style="{StaticResource Style.Text.Body.Medium}"
                                           TextWrapping="Wrap"
                                           MaxHeight="{StaticResource Size.BatchPreview.Text.MaximumHeight}"
                                           Margin="{StaticResource Thickness.Gap.Stack.Before.XS}" />
                                <Border Width="{StaticResource Size.BatchPreview.Thumbnail.Width}"
                                        Height="{StaticResource Size.BatchPreview.Thumbnail.Height}"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.Surface.Subtle}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Margin="{StaticResource Thickness.BatchPreview.Thumbnail}"
                                        Visibility="{Binding ImageVisibility}">
                                    <Grid AutomationProperties.Name="{Binding AutomationName}">
                                        <TextBlock Text="图片预览"
                                                   Style="{StaticResource Style.Text.Body.Small}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DimensionText}"
                                           Style="{StaticResource Style.Text.Body.Small}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Margin="{StaticResource Thickness.Gap.Stack.Before.XS}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="{StaticResource Thickness.Gap.Stack.Before.XS}"
                                            Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE783;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource Brush.Status.Error}"
                                               AutomationProperties.Name="图片加载错误" />
                                    <TextBlock Text="{Binding LoadError}"
                                               Style="{StaticResource Style.Text.Body.Small}"
                                               Foreground="{DynamicResource Brush.Status.Error}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource Thickness.Gap.Inline.Before.XS}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="{StaticResource Thickness.BatchPreview.Footer}">
            <Button Content="关闭"
                    Style="{StaticResource Style.Button.Ghost}"
                    MinWidth="{StaticResource Size.BatchPreview.CloseButton.MinimumWidth}"
                    AutomationProperties.Name="关闭分批预览"
                    Click="Close_Click" />
            <Button x:Name="ConfirmButton"
                    Content="确认分批发送"
                    Style="{StaticResource Style.Button.Primary}"
                    MinWidth="{StaticResource Size.BatchPreview.ConfirmButton.MinimumWidth}"
                    Margin="{StaticResource Thickness.BatchPreview.ConfirmButton}"
                    AutomationProperties.Name="确认分批发送"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
