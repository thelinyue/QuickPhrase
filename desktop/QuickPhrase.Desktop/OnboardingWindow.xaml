<Window x:Class="QuickPhrase.Desktop.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:onboarding="clr-namespace:QuickPhrase.Desktop.Onboarding"
        xmlns:designSystem="clr-namespace:QuickPhrase.Desktop.DesignSystem.Components"
        Title="闪语 · 使用引导" Width="{StaticResource Size.Onboarding.Width}" Height="{StaticResource Size.Onboarding.Height}" MinWidth="{StaticResource Size.Onboarding.MinimumWidth}" MinHeight="{StaticResource Size.Onboarding.MinimumHeight}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Style="{StaticResource Style.Dialog.Window}"
        Background="{DynamicResource Brush.Background.Default}" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!--
            所有步骤共享同一个内容起点。步骤面板只切换可见性和透明度，
            不再通过 VerticalAlignment="Center" 参与窗口高度与 Footer 定位。
        -->
        <Style x:Key="StepPanelBase" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="WelcomeStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Welcome}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Category}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhraseStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Phrase}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PracticeStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Practice}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompleteStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Complete}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource Style.Button.Primary}">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Default}" />
        </Style>
        <Style x:Key="FooterGhostButton" TargetType="Button" BasedOn="{StaticResource Style.Button.Ghost}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Default}" />
        </Style>
        <Style x:Key="FooterPrimaryButton" TargetType="Button" BasedOn="{StaticResource Style.Button.Primary}">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Default}" />
        </Style>

        <Style x:Key="WelcomeFooterButton" TargetType="Button" BasedOn="{StaticResource FooterGhostButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Welcome}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WelcomeFooterPrimaryButton" TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Welcome}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryFooterButton" TargetType="Button" BasedOn="{StaticResource FooterGhostButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Category}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryFooterPrimaryButton" TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Category}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BackFooterButton" TargetType="Button" BasedOn="{StaticResource FooterGhostButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Category}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Phrase}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Practice}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhraseFooterPrimaryButton" TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Phrase}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PracticeFooterPrimaryButton" TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Practice}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompleteFooterButton" TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Complete}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 单分类只读字段复用 Card 表面，并收敛为输入控件的高度、圆角与内边距。 -->
        <Style x:Key="SingleCategoryField" TargetType="Border" BasedOn="{StaticResource Style.Card.Default}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Default}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.Control.Input}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSingleCategory}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MultipleCategoryField" TargetType="ComboBox" BasedOn="{StaticResource Style.Select.Default}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultipleCategories}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PracticeOpenedStatusText" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body.Medium}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PracticeStarting}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></DataTrigger>
                <DataTrigger Binding="{Binding PracticeOpened}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PracticeSearchedStatusText" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body.Medium}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Style.Triggers><DataTrigger Binding="{Binding PracticeSearched}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PracticeInsertedStatusText" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body.Medium}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Style.Triggers><DataTrigger Binding="{Binding PracticeInserted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource Thickness.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Size.Onboarding.TitleBar.GridLength}" />
            <RowDefinition Height="{StaticResource Size.Onboarding.Header.GridLength}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource Size.Onboarding.Footer.GridLength}" />
        </Grid.RowDefinitions>

        <!-- Header：产品身份，不随步骤变化。 -->
        <Grid Grid.Row="0">
            <TextBlock Text="闪语" Style="{StaticResource Style.Text.Caption.Accent}" />
            <TextBlock Text="念起，即达" Style="{StaticResource Style.Text.Caption}" HorizontalAlignment="Right" />
        </Grid>

        <!-- StepHeader：标题和进度固定在同一行区域。 -->
        <Grid Grid.Row="1" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Style.Text.Title.Large}" />
            <TextBlock Grid.Column="1" Text="{Binding StepNumber, StringFormat=第 {0} 步 / 5}" Style="{StaticResource Style.Text.Caption}" VerticalAlignment="Center" />
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding StepNumber, Mode=OneWay}" Maximum="5" Height="{StaticResource Size.Onboarding.Progress.Height}" Margin="{StaticResource Thickness.Gap.Stack.Before.MD}"
                         Foreground="{DynamicResource Brush.Accent.Primary}" Background="{DynamicResource Brush.Border.Default}" />
        </Grid>

        <!-- Content：最小高度已按完整步骤内容预留空间，因此不使用页面级滚动条；长话术正文仍由输入框自身滚动。 -->
        <Grid x:Name="ContentRegion" Grid.Row="2" Margin="{StaticResource Thickness.Onboarding.Content}" ClipToBounds="True">
            <Border x:Name="WelcomeStepPanel" Style="{StaticResource WelcomeStepPanel}">
                <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="让常用表达，随手可得。" Style="{StaticResource Style.Text.Title.Medium}" />
                        <TextBlock Text="用约 30–60 秒完成基础设置，之后按 Alt + Space 就能快速找到话术。" Style="{StaticResource Style.Text.Body.Medium}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Gap.Stack.Before.MD}" />
                        <StackPanel Margin="{StaticResource Thickness.Gap.Stack.Before.XL}">
                            <TextBlock Text="这次会完成" Style="{StaticResource Style.Text.Caption.Primary}" />
                            <TextBlock Text="1  创建一个一级分类" Style="{StaticResource Style.Text.Body.Medium}" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" />
                            <TextBlock Text="2  保存一条常用话术" Style="{StaticResource Style.Text.Body.Medium}" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" />
                            <TextBlock Text="3  用闪念体验一次快速查找" Style="{StaticResource Style.Text.Body.Medium}" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" />
                        </StackPanel>
                        <Border Style="{StaticResource Style.Card.Default}"
                                Padding="{StaticResource Thickness.MD}" Margin="{StaticResource Thickness.Gap.Stack.Before.XL}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="快捷键：Alt + Space。按下后输入关键词，再按 Enter 选择。" Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="修改快捷键" Command="{Binding ModifyShortcutCommand}" Style="{StaticResource Style.Button.Ghost.Compact}" Margin="{StaticResource Thickness.Gap.Inline.Before.LG}" />
                            </Grid>
                        </Border>
                </StackPanel>
            </Border>

            <Border x:Name="CategoryStepPanel" Style="{StaticResource CategoryStepPanel}">
                <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="先从一个清晰的分类开始。" Style="{StaticResource Style.Text.Title.Medium}" />
                        <TextBlock Text="例如：客户沟通、售后回复、项目协作。" Style="{StaticResource Style.Text.Body.Medium}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Onboarding.IntroDescription}" />
                        <TextBlock Text="分类名称" Style="{StaticResource Style.Text.Caption.Primary}" />
                        <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.Input.Default}" AutomationProperties.Name="引导分类名称" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" MaxLength="80">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CreateCategoryAndContinueCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                </StackPanel>
            </Border>

            <Border x:Name="PhraseStepPanel" Style="{StaticResource PhraseStepPanel}">
                <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="把最常用的一句话先存下来。" Style="{StaticResource Style.Text.Title.Medium}" />
                        <TextBlock Text="这条话术会保存到选定的一级分类中，之后可以随时修改。" Style="{StaticResource Style.Text.Body.Medium}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Onboarding.IntroDescription}" />

                        <TextBlock Text="保存到" Style="{StaticResource Style.Text.Caption.Primary}" />
                        <Border Style="{StaticResource SingleCategoryField}" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}">
                            <TextBlock Text="{Binding SelectedCategoryDisplayName}" Style="{StaticResource Style.Text.Body.Medium}" VerticalAlignment="Center" />
                        </Border>
                        <ComboBox Style="{StaticResource MultipleCategoryField}" ItemsSource="{Binding Categories}" AutomationProperties.Name="引导话术分类"
                                  SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" />

                        <TextBlock Text="话术标题" Style="{StaticResource Style.Text.Caption.Primary}" Margin="{StaticResource Thickness.Gap.Stack.Before.LG}" />
                        <TextBox Text="{Binding PhraseTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.Input.Default}" AutomationProperties.Name="引导话术标题" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" MaxLength="120" />

                        <TextBlock Text="话术内容" Style="{StaticResource Style.Text.Caption.Primary}" Margin="{StaticResource Thickness.Gap.Stack.Before.LG}" />
                        <TextBox Text="{Binding PhraseContent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="引导话术内容" AcceptsReturn="True" TextWrapping="Wrap"
                                 Style="{StaticResource Style.Input.Default}" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" Height="{StaticResource Size.Onboarding.PhraseBody.Height}" Padding="{StaticResource Thickness.Control.Input.Multiline}" Margin="{StaticResource Thickness.Gap.Stack.Before.SM}" />
                </StackPanel>
            </Border>

            <Border x:Name="PracticeStepPanel" Style="{StaticResource PracticeStepPanel}">
                <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="用真实闪念找回刚才的话术。" Style="{StaticResource Style.Text.Title.Medium}" />
                        <TextBlock Text="打开闪念，输入刚才的话术标题或正文中的关键词，再按 Enter 选择。练习只把结果返回给本向导，不会触碰剪贴板，也不会发送到其他应用。" Style="{StaticResource Style.Text.Body.Medium}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Onboarding.CopyBlock}" />
                        <Button Content="打开闪念（Alt + Space）" Command="{Binding BeginPracticeCommand}" Style="{StaticResource StepButton}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding PracticeHint}" Style="{StaticResource Style.Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Onboarding.CopyBlock}" />
                        <StackPanel>
                            <Grid Margin="{StaticResource Thickness.Gap.Stack.SM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Size.Onboarding.PracticeIndicator.Gutter.GridLength}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Ellipse Width="{StaticResource Size.Onboarding.PracticeIndicator.Diameter}" Height="{StaticResource Size.Onboarding.PracticeIndicator.Diameter}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Border.Default}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PracticeStarting}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding PracticeOpened}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding PracticeOpenedStatus}" Style="{StaticResource PracticeOpenedStatusText}" />
                            </Grid>
                            <Grid Margin="{StaticResource Thickness.Gap.Stack.SM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Size.Onboarding.PracticeIndicator.Gutter.GridLength}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Ellipse Width="{StaticResource Size.Onboarding.PracticeIndicator.Diameter}" Height="{StaticResource Size.Onboarding.PracticeIndicator.Diameter}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Border.Default}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding PracticeSearched}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding PracticeSearchedStatus}" Style="{StaticResource PracticeSearchedStatusText}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Size.Onboarding.PracticeIndicator.Gutter.GridLength}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Ellipse Width="{StaticResource Size.Onboarding.PracticeIndicator.Diameter}" Height="{StaticResource Size.Onboarding.PracticeIndicator.Diameter}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Border.Default}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding PracticeInserted}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding PracticeInsertedStatus}" Style="{StaticResource PracticeInsertedStatusText}" />
                            </Grid>
                        </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CompleteStepPanel" Style="{StaticResource CompleteStepPanel}">
                <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="设置已完成" Style="{StaticResource Style.Text.Title.Medium}" />
                        <TextBlock Text="以后按 Alt + Space 打开闪念，就能快速找到常用话术。你也可以在话术库中继续整理和完善内容。" Style="{StaticResource Style.Text.Body.Medium}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Onboarding.IntroDescription}" />
                        <Border Style="{StaticResource Style.Card.Default}" Padding="{StaticResource Thickness.MD}">
                            <TextBlock Text="第一条话术已经准备好，随时可以开始使用。" Style="{StaticResource Style.Text.Body.Medium}" />
                        </Border>
                        <designSystem:SettingItem Title="开机启动"
                                                   Description="登录 Windows 后自动启动 QuickPhrase"
                                                   Margin="{StaticResource Thickness.Gap.Stack.Before.XL}">
                            <designSystem:SettingItem.ControlContent>
                                <CheckBox IsChecked="{Binding LaunchOnStartup}"
                                          AutomationProperties.Name="开机时启动闪语"
                                          Style="{StaticResource Style.Switch.Default}"
                                          VerticalAlignment="Center" />
                            </designSystem:SettingItem.ControlContent>
                        </designSystem:SettingItem>
                        <TextBlock Text="{Binding StartupWarning}" Foreground="{DynamicResource Brush.Status.Error}" TextWrapping="Wrap" Margin="{StaticResource Thickness.Gap.Stack.Before.MD}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer：固定错误提示区和固定导航区，按钮只随步骤切换。 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource Size.Onboarding.FooterStatus.GridLength}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Error}"
                       TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="{StaticResource Size.Onboarding.FooterStatus.Height}" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="返回" Command="{Binding BackCommand}" Style="{StaticResource BackFooterButton}" Margin="{StaticResource Thickness.Gap.Inline.MD}" />
                    <Button Content="跳过引导" Command="{Binding SkipCommand}" Style="{StaticResource WelcomeFooterButton}" />
                    <Button Content="跳过引导" Command="{Binding SkipCommand}" Style="{StaticResource CategoryFooterButton}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="开始设置 →" Command="{Binding StartCommand}" Style="{StaticResource WelcomeFooterPrimaryButton}" />
                    <Button Content="创建并继续 →" Command="{Binding CreateCategoryAndContinueCommand}" Style="{StaticResource CategoryFooterPrimaryButton}" IsDefault="True" />
                    <Button Content="保存并继续 →" Command="{Binding SavePhraseAndContinueCommand}" Style="{StaticResource PhraseFooterPrimaryButton}" Margin="{StaticResource Thickness.Gap.Inline.Before.MD}" />
                    <Button Content="继续 →" Command="{Binding FinishCommand}" Style="{StaticResource PracticeFooterPrimaryButton}" Margin="{StaticResource Thickness.Gap.Inline.Before.MD}" />
                    <Button Content="进入话术库 →" Command="{Binding CloseCompleteCommand}" Style="{StaticResource CompleteFooterButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
