<Window x:Class="QuickPhrase.Desktop.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:onboarding="clr-namespace:QuickPhrase.Desktop.Onboarding"
        Title="闪语 · 使用引导" Width="620" Height="520" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="StepPanelBase" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="WelcomeStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Welcome}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CategoryStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Category}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PhraseStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Phrase}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PracticeStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Practice}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CompleteStepPanel" TargetType="Border" BasedOn="{StaticResource StepPanelBase}">
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static onboarding:OnboardingStep.Complete}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="120" /><Setter Property="MinHeight" Value="36" />
        </Style>
    </Window.Resources>
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="闪语 · 念起，即达" Style="{StaticResource TextCaption}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource TextH1}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding StepNumber, StringFormat=第 {0} 步 / 5}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,20">
            <Border Style="{StaticResource WelcomeStepPanel}"><StackPanel VerticalAlignment="Center"><TextBlock Text="欢迎使用闪语" Style="{StaticResource TextH1}"/><TextBlock Text="用 30–60 秒创建一个分类和一条常用话术，然后用闪念快速找到它。" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,16,0,0"/><TextBlock Text="按下 Alt + Space 打开闪念，输入关键词后按 Enter。" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="开始设置" Command="{Binding StartCommand}" Style="{StaticResource StepButton}" HorizontalAlignment="Left" Margin="0,24,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CategoryStepPanel}"><StackPanel VerticalAlignment="Center"><TextBlock Text="先创建一个一级分类" Style="{StaticResource TextH2}"/><TextBlock Text="例如：客户沟通、售后回复、项目协作。" Style="{StaticResource TextCaption}" Margin="0,8,0,16"/><TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Height="36" MinWidth="300"/><Button Content="创建分类并继续" Command="{Binding CreateCategoryAndContinueCommand}" Style="{StaticResource StepButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PhraseStepPanel}"><StackPanel VerticalAlignment="Center"><TextBlock Text="写下第一条话术" Style="{StaticResource TextH2}"/><TextBlock Text="它会保存到刚刚创建的分类中，也可以选择已有一级分类。" Style="{StaticResource TextCaption}" Margin="0,8,0,14"/><TextBox Text="{Binding PhraseTitle, UpdateSourceTrigger=PropertyChanged}" Height="36" ToolTip="话术标题"/><TextBox Text="{Binding PhraseContent, UpdateSourceTrigger=PropertyChanged}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" ToolTip="话术正文"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Height="34" Margin="0,10,0,0"/><Button Content="保存话术并继续" Command="{Binding SavePhraseAndContinueCommand}" Style="{StaticResource StepButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PracticeStepPanel}"><StackPanel VerticalAlignment="Center"><TextBlock Text="用真实闪念找回刚才的话术" Style="{StaticResource TextH2}"/><TextBlock Text="点击打开闪念，输入标题或正文中的关键词，再按 Enter。这里不会触碰剪贴板，也不会向其他应用发送内容。" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,8,0,16"/><Button Content="打开闪念" Command="{Binding BeginPracticeCommand}" Style="{StaticResource StepButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding PracticeInput, StringFormat=练习输入区：{0}}" TextWrapping="Wrap" Style="{StaticResource TextBody}" Margin="0,18,0,0"/><TextBlock Text="状态：" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/><TextBlock Text="{Binding PracticeOpened, StringFormat=已打开：{0}}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding PracticeSearched, StringFormat=已搜索：{0}}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding PracticeInserted, StringFormat=已插入：{0}}" Style="{StaticResource TextCaption}"/><Button Content="完成引导" Command="{Binding FinishCommand}" IsEnabled="{Binding CanFinish}" Style="{StaticResource StepButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CompleteStepPanel}"><StackPanel VerticalAlignment="Center"><TextBlock Text="准备完成" Style="{StaticResource TextH2}"/><TextBlock Text="之后你可以随时按 Alt + Space 打开闪念，也可以在设置中重新查看引导。" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,12,0,18"/><CheckBox Content="开机时启动闪语" IsChecked="{Binding LaunchOnStartup}"/><TextBlock Text="{Binding StartupWarning}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="进入话术库" Command="{Binding CloseCompleteCommand}" Style="{StaticResource StepButton}" HorizontalAlignment="Left" Margin="0,24,0,0"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Button Content="修改快捷键" Command="{Binding ModifyShortcutCommand}" Style="{StaticResource GhostButton}" Margin="0,0,12,0"/><Button Content="跳过" Command="{Binding SkipCommand}" Style="{StaticResource GhostButton}"/></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="280" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
