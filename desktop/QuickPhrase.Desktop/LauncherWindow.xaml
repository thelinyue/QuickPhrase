<Window x:Class="QuickPhrase.Desktop.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickPhrase.Desktop"
        xmlns:controls="clr-namespace:QuickPhrase.Desktop.Controls"
        xmlns:shared="clr-namespace:QuickPhrase.Desktop.Views.Shared"
        Title=""
        Width="{StaticResource Size.Launcher.Width}"
        Height="{StaticResource Size.Launcher.Height}"
        MinWidth="{StaticResource Size.Launcher.MinimumWidth}"
        MinHeight="{StaticResource Size.Launcher.MinimumHeight}"
        MaxHeight="{StaticResource Size.Launcher.MaximumHeight}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <DataTemplate x:Key="LauncherPhraseTemplate">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Template.Phrase.CompactRow}">
                <ContentControl.ContextMenu>
                    <ContextMenu Opened="OnContextMenuOpened">
                        <MenuItem Header="发送到输入区" InputGestureText="双击" Click="OnInsertContextMenuClick" />
                        <MenuItem Header="复制内容到剪贴板" Click="OnCopyContextMenuClick" />
                    </ContextMenu>
                </ContentControl.ContextMenu>
            </ContentControl>
        </DataTemplate>
    </Window.Resources>
    <!-- 外层仅保留布局留白：闪念搜索框、历史与结果不再被卡片边框、背景或阴影包裹。 -->
    <Border x:Name="LauncherSurface"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="{StaticResource Thickness.LG}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 空查询时在搜索框下方展示历史快捷入口；输入关键词后由结果区取代。 -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="QueryBox"
                     Grid.Row="0"
                     Style="{StaticResource Style.Input.Search}"
                     AutomationProperties.Name="Launcher搜索框"
                     GotKeyboardFocus="QueryBox_GotKeyboardFocus"
                     LostKeyboardFocus="QueryBox_LostKeyboardFocus"
                     TextChanged="OnQueryChanged" />
            <TextBlock x:Name="QueryHintText"
                       Grid.Row="0"
                       Margin="{StaticResource Thickness.Control.Input}"
                       Text="可搜索话术标题、正文或拼音"
                       Style="{StaticResource Style.Text.InputHint}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Focusable="False"
                       Visibility="Collapsed" />

            <Border x:Name="SearchHistoryHost"
                    Grid.Row="1"
                    Margin="{StaticResource Thickness.Gap.Stack.Before.XS}"
                    Width="{Binding ActualWidth, ElementName=QueryBox}"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    LostKeyboardFocus="SearchHistoryHost_LostKeyboardFocus">
                <shared:SearchHistoryView x:Name="SearchHistoryPanel"
                                          QuerySelected="SearchHistoryPanel_QuerySelected"
                                          ClearRequested="SearchHistoryPanel_ClearRequested" />
            </Border>
            <ListBox x:Name="ResultsList"
                     Grid.Row="2"
                     Margin="{StaticResource Thickness.Launcher.Section}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnResultsDoubleClick"
                     ItemTemplate="{StaticResource LauncherPhraseTemplate}"
                     local:PhraseListActions.ShowSendButton="False"
                     ItemContainerStyle="{StaticResource Style.ListItem.Phrase.Compact}" />

            <!-- Tab 预览与结果列表保持同一信息密度：仅显示当前选中的序号、标题和正文。 -->
            <Grid x:Name="PreviewHost"
                  Grid.Row="2"
                  Margin="{StaticResource Thickness.Launcher.Section}"
                  DataContext="{Binding SelectedItem, ElementName=ResultsList}"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Size.Phrase.IndexColumn.GridLength}" />
                    <ColumnDefinition Width="{StaticResource Size.Launcher.Phrase.TitleColumn.GridLength}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PreviewIndex"
                           Style="{StaticResource Style.Text.Mono}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Thickness.Gap.Inline.SM}"
                           Text="{Binding IndexInCategory}" />
                <controls:OverflowTextBlock x:Name="PreviewTitle"
                                            Grid.Column="1"
                                            Style="{StaticResource Style.Text.Label}"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource Thickness.Gap.Inline.MD}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Title}" />
                <controls:OverflowTextBlock x:Name="PreviewContent"
                                            Grid.Column="2"
                                            Style="{StaticResource Style.Text.Body.Medium}"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource Thickness.Gap.Inline.XS}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Content}" />
            </Grid>

            <shared:StatePresenter x:Name="EmptyState"
                                   Grid.Row="2"
                                   StateKind="{x:Static shared:StateKind.Empty}"
                                   Title="没有找到匹配话术"
                                   Description="换个关键词试试；也可以按 Enter 创建话术。"
                                   Visibility="Collapsed" />
            <shared:StatePresenter x:Name="LoadingState"
                                   Grid.Row="2"
                                   StateKind="{x:Static shared:StateKind.Loading}"
                                   Title="正在准备搜索"
                                   Description="正在恢复内存搜索索引，请稍候。"
                                   Visibility="Collapsed" />
            <shared:StatePresenter x:Name="SearchRetryState"
                                   Grid.Row="2"
                                   StateKind="{x:Static shared:StateKind.Error}"
                                   Title="搜索暂时不可用"
                                   Description="搜索索引初始化失败，请重试。"
                                   ActionText="重试"
                                   Visibility="Collapsed" />

            <TextBlock Grid.Row="3"
                       x:Name="KeyboardHints"
                       Style="{StaticResource Style.Text.Caption}"
                       Visibility="Collapsed"
                       VerticalAlignment="Center">
                <Run Text="↑ ↓ 选择" />
                <Run Text="&#x2002;&#x2002;" />
                <Run x:Name="InsertHintText" Text="Enter 插入" Foreground="{DynamicResource Brush.Accent.Primary}" FontWeight="SemiBold" />
                <Run Text="&#x2002;&#x2002;" />
                <Run x:Name="SendHintText" Text="Ctrl+Enter 插入并发送" />
                <Run Text="&#x2002;&#x2002;" />
                <Run x:Name="PreviewHintText" Text="Tab 预览 · Esc 关闭" />
            </TextBlock>
        </Grid>
    </Border>
</Window>
